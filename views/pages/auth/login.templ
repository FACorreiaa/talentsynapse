package auth

import "github.com/FACorreiaa/skillsphere-pwa/views/layouts"
import "github.com/FACorreiaa/skillsphere-pwa/views/components"

templ Login(errorMsg string, successMsg string) {
	@layouts.Base("Sign In | SkillSphere") {
		<div class="min-h-screen flex flex-col bg-background">
			@components.Navbar(false, "", "")
			
			<main class="flex-1 flex items-center justify-center py-12 px-4">
				<div class="w-full max-w-5xl flex rounded-2xl overflow-hidden shadow-2xl">
					<!-- Left Side - Illustration -->
					<div class="hidden lg:flex lg:w-1/2 auth-illustration relative">
						<div class="absolute inset-0 bg-gradient-to-br from-primary via-primary/80 to-accent"></div>
						<div class="absolute inset-0 pattern-dots opacity-10"></div>
						<div class="relative z-10 p-12 flex flex-col justify-center text-primary-foreground">
							<div class="animate-fade-in-up">
								<h2 class="text-4xl font-bold mb-4 font-heading">Welcome Back!</h2>
								<p class="text-lg opacity-90 mb-8">
									Continue your skill exchange journey. Connect with learners and experts worldwide.
								</p>
								<div class="space-y-4">
									<div class="flex items-center gap-3">
										<div class="w-10 h-10 rounded-full bg-white/20 flex items-center justify-center">
											<svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
												<path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
											</svg>
										</div>
										<span>Find your perfect skill match</span>
									</div>
									<div class="flex items-center gap-3">
										<div class="w-10 h-10 rounded-full bg-white/20 flex items-center justify-center">
											<svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
												<path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
											</svg>
										</div>
										<span>Learn from real experts</span>
									</div>
									<div class="flex items-center gap-3">
										<div class="w-10 h-10 rounded-full bg-white/20 flex items-center justify-center">
											<svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
												<path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
											</svg>
										</div>
										<span>Share your knowledge</span>
									</div>
								</div>
							</div>
						</div>
					</div>
					
					<!-- Right Side - Form -->
					<div class="w-full lg:w-1/2 bg-card p-8 md:p-12">
						<div class="max-w-md mx-auto">
							<!-- Flash Messages -->
							if errorMsg != "" {
								@components.FlashMessage(errorMsg, "error")
							}
							if successMsg != "" {
								@components.FlashMessage(successMsg, "success")
							}
							
							<div class="text-center mb-8 animate-fade-in">
								<h1 class="text-3xl font-bold text-foreground mb-2">Sign In</h1>
								<p class="text-muted-foreground">Enter your credentials to access your account</p>
							</div>
							
							<form action="/login" method="POST" class="space-y-5 animate-fade-in-up delay-100">
								<!-- Email Field -->
								<div class="space-y-2">
									<label for="email" class="text-sm font-medium text-foreground">Email</label>
									<input 
										type="email" 
										id="email" 
										name="email" 
										placeholder="you@example.com"
										required
										class="input w-full"
										autocomplete="email"
									/>
								</div>
								
								<!-- Password Field -->
								<div class="space-y-2">
									<div class="flex justify-between items-center">
										<label for="password" class="text-sm font-medium text-foreground">Password</label>
										<a href="/forgot-password" class="text-sm text-primary hover:text-primary/80 transition-colors">
											Forgot password?
										</a>
									</div>
									<div class="relative" data-password-toggle>
										<input 
											type="password"
											id="password" 
											name="password" 
											placeholder="••••••••"
											required
											class="input w-full pr-10"
											autocomplete="current-password"
										/>
										<button
											type="button"
											_="on click
												toggle the *type of #password between 'password' and 'text'
												toggle .hidden on .eye-open in me
												toggle .hidden on .eye-closed in me"
											class="absolute right-3 top-1/2 -translate-y-1/2 text-muted-foreground hover:text-foreground transition-colors"
										>
											<svg class="w-5 h-5 eye-open" fill="none" stroke="currentColor" viewBox="0 0 24 24">
												<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
												<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
											</svg>
											<svg class="w-5 h-5 eye-closed hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
												<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l3.59 3.59m0 0A9.953 9.953 0 0112 5c4.478 0 8.268 2.943 9.543 7a10.025 10.025 0 01-4.132 5.411m0 0L21 21"></path>
											</svg>
										</button>
									</div>
								</div>
								
								<!-- Remember Me -->
								<div class="flex items-center gap-2">
									<input type="checkbox" id="remember" name="remember" class="checkbox"/>
									<label for="remember" class="text-sm text-muted-foreground">Remember me for 30 days</label>
								</div>
								
								<!-- Submit Button -->
								<button type="submit" class="btn btn-primary btn-glow w-full py-3 text-base font-semibold">
									Sign In
								</button>
							</form>
							
							<!-- Divider -->
							<div class="relative my-8">
								<div class="absolute inset-0 flex items-center">
									<div class="w-full border-t border-border"></div>
								</div>
								<div class="relative flex justify-center text-sm">
									<span class="px-4 bg-card text-muted-foreground">Or continue with</span>
								</div>
							</div>
							
							<!-- Social Login -->
							<div class="grid grid-cols-2 gap-4 animate-fade-in-up delay-200">
								<button type="button" disabled class="btn btn-outline flex items-center justify-center gap-2 py-2.5 opacity-50 cursor-not-allowed">
									<svg class="w-5 h-5" viewBox="0 0 24 24">
										<path fill="currentColor" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"></path>
										<path fill="currentColor" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"></path>
										<path fill="currentColor" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"></path>
										<path fill="currentColor" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"></path>
									</svg>
									Google
								</button>
								<button type="button" disabled class="btn btn-outline flex items-center justify-center gap-2 py-2.5 opacity-50 cursor-not-allowed">
									<svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
										<path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"></path>
									</svg>
									GitHub
								</button>
							</div>
							<p class="text-center text-xs text-muted-foreground mt-2">Social login coming soon</p>
							
							<!-- Sign Up Link -->
							<p class="text-center text-sm text-muted-foreground mt-8">
								Don't have an account? 
								<a href="/register" class="text-primary font-semibold hover:text-primary/80 transition-colors">
									Sign up for free
								</a>
							</p>
						</div>
					</div>
				</div>
			</main>
			
			@components.Footer()
		</div>
	}
}
