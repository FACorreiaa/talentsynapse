# Application
PORT=8080
GO_ENV=development

# Database
DATABASE_URL=postgres://postgres:postgres@localhost:5432/myapp?sslmode=disable

# Security (generate your own secrets in production!)
# JWT_SECRET=your-secret-key-here
SESSION_SECRET=your-32-byte-secret-key-here
SESSION_MAX_AGE=86400

# External Services (optional)
# REDIS_URL=redis://localhost:6379
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=

# Observability (optional)
# JAEGER_ENDPOINT=http://localhost:14268/api/traces
# PROMETHEUS_ENABLED=true
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# New Relic APM (optional - for production monitoring)
# NEW_RELIC_APP_NAME=TalentSynapse
# NEW_RELIC_LICENCE_KEY=your-new-relic-license-key
# NEW_RELIC_ACCOUNT_ID=your-account-id
# NEW_RELIC_REGION=EU  # or US
