# TalentSynapse PWA - Caddy Configuration
# ============================================
# ⚠️  IMPORTANT: Replace "your-domain.com" with your actual domain!
# This handles HTTPS automatically via Let's Encrypt
# Your Go binary stays simple and runs on :8080

{
    # Global options
    email admin@talentsynapse.org
}

# Development (optional - if you want local HTTPS testing)
# localhost:8443 {
#     tls internal
#     reverse_proxy localhost:8080
# }

# Production
talentsynapse.org {
    # Automatic HTTPS via Let's Encrypt
    # No configuration needed!

    # Enable compression (though your Go app already does this)
    encode gzip zstd

    # PWA-specific: Cache-Control headers for static assets
    header /assets/* {
        # Cache CSS/JS/images for 1 year (they're embedded in binary anyway)
        Cache-Control "public, max-age=31536000, immutable"
    }

    # Service Worker: NO cache (must always be fresh)
    header /assets/static/sw.js {
        Cache-Control "no-cache, no-store, must-revalidate"
        -Server  # Hide server header
    }

    # Manifest: cache for 1 day
    header /assets/static/manifest.json {
        Cache-Control "public, max-age=86400"
    }

    # Health check endpoint bypass (optional: for monitoring)
    handle /health {
        reverse_proxy localhost:8080 {
            health_uri /health
            health_interval 10s
            health_timeout 5s
        }
    }

    # Everything else proxies to Go
    reverse_proxy localhost:8080 {
        # Keep connection alive during deployments
        fail_duration 30s

        # Add these headers for HTMX/PWA
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }

    # Optional: Custom error pages
    # handle_errors {
    #     @502-503 expression {http.error.status_code} in [502, 503]
    #     rewrite @502-503 /errors/maintenance.html
    #     file_server
    # }
}

# Optional: Redirect www to non-www
www.talentsynapse.org {
    redir https://talentsynapse.org{uri} permanent
}
