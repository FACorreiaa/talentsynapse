package dashboard

import "github.com/FACorreiaa/talentsynapse/internal/app/views/layouts"
import "github.com/FACorreiaa/talentsynapse/internal/app/views/components"
import "strconv"
import "fmt"

// DashboardStats contains the main stats cards data
type DashboardStats struct {
	Points   int
	Tier     string
	Matches  int
	Sessions int
}

// TopMatch represents a potential match to display
type TopMatch struct {
	UserID      string
	DisplayName string
	Username    string
	AvatarURL   string
	Skills      string
	MatchScore  int
}

// ActivityItem represents a recent activity entry
type ActivityItem struct {
	Type     string
	UserName string
	Action   string
	TimeAgo  string
}

// ProfileStrength contains profile completion data
type ProfileStrength struct {
	Percentage       int
	HasAvatar        bool
	HasBio           bool
	HasOfferedSkills bool
	HasWantedSkills  bool
	HasSession       bool
	HasSocialLinks   bool
}

// DashboardData contains all data needed for the dashboard
type DashboardData struct {
	UserName        string
	UserAvatar      string
	SuccessMsg      string
	Stats           DashboardStats
	TopMatches      []TopMatch
	Activities      []ActivityItem
	ProfileStrength ProfileStrength
}

// Dashboard renders the full dashboard page with AppLayout (navbar/footer outside swap area)
templ Dashboard(data DashboardData) {
	@layouts.AppLayout("Dashboard | TalentSynapse", true, data.UserName, data.UserAvatar) {
		@DashboardContent(data)
	}
}

// DashboardContent renders just the main content (for HTMX partial swaps)
templ DashboardContent(data DashboardData) {
	<div class="py-8 px-4">
		<div class="container mx-auto max-w-7xl">
			<!-- Flash Messages -->
			if data.SuccessMsg != "" {
				@components.FlashMessage(data.SuccessMsg, "success")
			}
			<!-- Welcome Header -->
			<div class="mb-8 animate-fade-in-up">
				<h1 class="text-3xl md:text-4xl font-bold text-foreground mb-2">
					Welcome back, <span class="text-gradient">{ data.UserName }</span>! 👋
				</h1>
				<p class="text-muted-foreground">
					Here's what's happening with your skill exchange journey.
				</p>
			</div>
			<!-- Stats Cards -->
			<div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-8">
				@statCard("Points", strconv.Itoa(data.Stats.Points), "text-amber-500", pointsIcon())
				@statCard("Tier", data.Stats.Tier, "text-purple-500", tierIcon())
				@statCard("Matches", strconv.Itoa(data.Stats.Matches), "text-emerald-500", matchesIcon())
				@statCard("Sessions", strconv.Itoa(data.Stats.Sessions), "text-blue-500", sessionsIcon())
			</div>
			<!-- Main Content Grid -->
			<div class="grid lg:grid-cols-3 gap-6">
				<!-- Left Column - Activity & Actions -->
				<div class="lg:col-span-2 space-y-6">
					<!-- Quick Actions -->
					<div class="glass-card rounded-xl p-6 animate-fade-in-up delay-100">
						<h2 class="text-lg font-semibold text-foreground mb-4">Quick Actions</h2>
						<div class="grid sm:grid-cols-3 gap-3">
							<a href="/skills/add" class="flex items-center gap-3 p-4 rounded-lg bg-primary/10 hover:bg-primary/20 transition-colors group">
								<div class="w-10 h-10 rounded-full bg-primary/20 flex items-center justify-center group-hover:scale-110 transition-transform">
									<svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
									</svg>
								</div>
								<span class="font-medium text-foreground">Add Skill</span>
							</a>
							<a href="/discover" class="flex items-center gap-3 p-4 rounded-lg bg-blue-500/10 hover:bg-blue-500/20 transition-colors group">
								<div class="w-10 h-10 rounded-full bg-blue-500/20 flex items-center justify-center group-hover:scale-110 transition-transform">
									<svg class="w-5 h-5 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
									</svg>
								</div>
								<span class="font-medium text-foreground">Browse Skills</span>
							</a>
							<a href="/messages" class="flex items-center gap-3 p-4 rounded-lg bg-purple-500/10 hover:bg-purple-500/20 transition-colors group">
								<div class="w-10 h-10 rounded-full bg-purple-500/20 flex items-center justify-center group-hover:scale-110 transition-transform">
									<svg class="w-5 h-5 text-purple-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path>
									</svg>
								</div>
								<span class="font-medium text-foreground">Messages</span>
							</a>
						</div>
					</div>
					<!-- Recent Activity -->
					<div class="glass-card rounded-xl p-6 animate-fade-in-up delay-200">
						<div class="flex items-center justify-between mb-4">
							<h2 class="text-lg font-semibold text-foreground">Recent Activity</h2>
							<a href="/matches" class="text-sm text-primary hover:underline">View all</a>
						</div>
						<div class="space-y-4">
							if len(data.Activities) > 0 {
								for _, activity := range data.Activities {
									@activityItem(activity.UserName, activity.Action, activity.TimeAgo, activity.Type)
								}
							} else {
								@activityItem("Welcome", "Start by adding skills you can teach and want to learn!", "Just now", "info")
							}
						</div>
					</div>
				</div>
				<!-- Right Column - Matches & Recommendations -->
				<div class="space-y-6">
					<!-- Suggested Matches -->
					<div class="glass-card rounded-xl p-6 animate-fade-in-up delay-300">
						<div class="flex items-center justify-between mb-4">
							<h2 class="text-lg font-semibold text-foreground">Top Matches</h2>
							<a href="/matches" class="text-sm text-primary hover:underline">See all</a>
						</div>
						<div class="space-y-3">
							if len(data.TopMatches) > 0 {
								for _, match := range data.TopMatches {
									@matchCard(match.DisplayName, match.Skills, fmt.Sprintf("%d%%", match.MatchScore), match.AvatarURL, match.UserID)
								}
							} else {
								<p class="text-sm text-muted-foreground text-center py-4">
									Add skills to find matches!
								</p>
							}
						</div>
					</div>
					<!-- Profile Completion -->
					<div class="glass-card rounded-xl p-6 animate-fade-in-up delay-400">
						<h2 class="text-lg font-semibold text-foreground mb-4">Profile Strength</h2>
						<div class="relative pt-1">
							<div class="flex items-center justify-between mb-2">
								<span class="text-sm font-medium text-foreground">{ strconv.Itoa(data.ProfileStrength.Percentage) }% Complete</span>
								if data.ProfileStrength.Percentage < 100 {
									<span class="text-xs text-muted-foreground">+{ strconv.Itoa(100 - data.ProfileStrength.Percentage) }% to unlock all features</span>
								}
							</div>
							<div class="overflow-hidden h-2 rounded-full bg-muted">
								<div class="h-full rounded-full bg-gradient-to-r from-primary to-accent" style={ fmt.Sprintf("width: %d%%", data.ProfileStrength.Percentage) }></div>
							</div>
						</div>
						<div class="mt-4 space-y-2">
							@profileCheckItem("Add profile photo", data.ProfileStrength.HasAvatar)
							@profileCheckItem("Add bio", data.ProfileStrength.HasBio)
							@profileCheckItem("Add 3+ skills you can teach", data.ProfileStrength.HasOfferedSkills)
							@profileCheckItem("Add 3+ skills you want to learn", data.ProfileStrength.HasWantedSkills)
							@profileCheckItem("Complete your first session", data.ProfileStrength.HasSession)
							@profileCheckItem("Add social links", data.ProfileStrength.HasSocialLinks)
						</div>
						<a href="/profile" class="btn btn-outline w-full mt-4">
							Complete Profile
						</a>
					</div>
				</div>
			</div>
		</div>
	</div>
}

templ statCard(title string, value string, colorClass string, icon templ.Component) {
	<div class="glass-card rounded-xl p-5 animate-fade-in-up">
		<div class="flex items-center justify-between">
			<div>
				<p class="text-sm text-muted-foreground mb-1">{ title }</p>
				<p class={ "text-2xl font-bold", colorClass }>{ value }</p>
			</div>
			<div class={ "w-12 h-12 rounded-full flex items-center justify-center", colorClass + "/10" }>
				@icon
			</div>
		</div>
	</div>
}

templ skillsOfferedIcon() {
	<svg class="w-6 h-6 text-emerald-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
		<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
	</svg>
}

templ skillsWantedIcon() {
	<svg class="w-6 h-6 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
		<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
	</svg>
}

templ matchesIcon() {
	<svg class="w-6 h-6 text-amber-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
		<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
	</svg>
}

templ sessionsIcon() {
	<svg class="w-6 h-6 text-purple-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
		<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
	</svg>
}

templ activityItem(name string, action string, time string, activityType string) {
	<div class="flex items-start gap-3 p-3 rounded-lg hover:bg-muted/50 transition-colors">
		@activityIcon(activityType)
		<div class="flex-1 min-w-0">
			<p class="text-sm text-foreground">
				<span class="font-medium">{ name }</span> { action }
			</p>
			<p class="text-xs text-muted-foreground">{ time }</p>
		</div>
	</div>
}

templ activityIcon(activityType string) {
	switch activityType {
		case "match":
			<div class="w-8 h-8 rounded-full bg-amber-500/10 flex items-center justify-center flex-shrink-0">
				<svg class="w-4 h-4 text-amber-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path>
				</svg>
			</div>
		case "session":
			<div class="w-8 h-8 rounded-full bg-emerald-500/10 flex items-center justify-center flex-shrink-0">
				<svg class="w-4 h-4 text-emerald-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
				</svg>
			</div>
		case "message":
			<div class="w-8 h-8 rounded-full bg-blue-500/10 flex items-center justify-center flex-shrink-0">
				<svg class="w-4 h-4 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path>
				</svg>
			</div>
		default:
			<div class="w-8 h-8 rounded-full bg-muted flex items-center justify-center flex-shrink-0">
				<svg class="w-4 h-4 text-muted-foreground" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
				</svg>
			</div>
	}
}

templ matchCard(name string, skills string, matchPercent string, avatar string, userID string) {
	<a href={ templ.SafeURL("/users/" + userID) } class="flex items-center gap-3 p-3 rounded-lg hover:bg-muted/50 transition-colors group">
		<div class="w-10 h-10 rounded-full bg-primary/20 flex items-center justify-center text-primary font-semibold text-sm flex-shrink-0">
			if len(name) > 0 {
				{ string([]rune(name)[0]) }
			}
		</div>
		<div class="flex-1 min-w-0">
			<p class="text-sm font-medium text-foreground truncate group-hover:text-primary transition-colors">{ name }</p>
			<p class="text-xs text-muted-foreground truncate">{ skills }</p>
		</div>
		<div class="text-xs font-semibold text-primary bg-primary/10 px-2 py-1 rounded-full">
			{ matchPercent }
		</div>
	</a>
}

templ profileCheckItem(label string, completed bool) {
	<div class="flex items-center gap-2 text-sm">
		if completed {
			<svg class="w-4 h-4 text-emerald-500" fill="currentColor" viewBox="0 0 20 20">
				<path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
			</svg>
			<span class="text-muted-foreground">{ label }</span>
		} else {
			<svg class="w-4 h-4 text-border" fill="currentColor" viewBox="0 0 20 20">
				<path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-11a1 1 0 10-2 0v2H7a1 1 0 100 2h2v2a1 1 0 102 0v-2h2a1 1 0 100-2h-2V7z" clip-rule="evenodd"></path>
			</svg>
			<span class="text-foreground">{ label }</span>
		}
	</div>
}

templ pointsIcon() {
	<svg class="w-6 h-6 text-amber-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
		<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
	</svg>
}

templ tierIcon() {
	<svg class="w-6 h-6 text-purple-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
		<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z"></path>
	</svg>
}
