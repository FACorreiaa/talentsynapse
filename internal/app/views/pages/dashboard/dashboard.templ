package dashboard

import "github.com/FACorreiaa/talentsynapse/internal/app/views/layouts"
import "github.com/FACorreiaa/talentsynapse/internal/app/views/components"

templ Dashboard(userName string, userAvatar string, successMsg string) {
	@layouts.Base("Dashboard | TalentSynapse") {
		<div class="min-h-screen flex flex-col bg-background">
			@components.Navbar(true, userName, userAvatar)
			<main class="flex-1 py-8 px-4">
				<div class="container mx-auto max-w-7xl">
					<!-- Flash Messages -->
					if successMsg != "" {
						@components.FlashMessage(successMsg, "success")
					}
					<!-- Welcome Header -->
					<div class="mb-8 animate-fade-in-up">
						<h1 class="text-3xl md:text-4xl font-bold text-foreground mb-2">
							Welcome back, <span class="text-gradient">{ userName }</span>! 👋
						</h1>
						<p class="text-muted-foreground">
							Here's what's happening with your skill exchange journey.
						</p>
					</div>
					<!-- Stats Cards -->
					<div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-8">
						@statCard("Skills Offered", "12", "text-emerald-500", skillsOfferedIcon())
						@statCard("Skills Wanted", "8", "text-blue-500", skillsWantedIcon())
						@statCard("Matches", "24", "text-amber-500", matchesIcon())
						@statCard("Sessions", "7", "text-purple-500", sessionsIcon())
					</div>
					<!-- Main Content Grid -->
					<div class="grid lg:grid-cols-3 gap-6">
						<!-- Left Column - Activity & Actions -->
						<div class="lg:col-span-2 space-y-6">
							<!-- Quick Actions -->
							<div class="glass-card rounded-xl p-6 animate-fade-in-up delay-100">
								<h2 class="text-lg font-semibold text-foreground mb-4">Quick Actions</h2>
								<div class="grid sm:grid-cols-3 gap-3">
									<a href="/skills/add" class="flex items-center gap-3 p-4 rounded-lg bg-primary/10 hover:bg-primary/20 transition-colors group">
										<div class="w-10 h-10 rounded-full bg-primary/20 flex items-center justify-center group-hover:scale-110 transition-transform">
											<svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
												<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
											</svg>
										</div>
										<span class="font-medium text-foreground">Add Skill</span>
									</a>
									<a href="/discover" class="flex items-center gap-3 p-4 rounded-lg bg-blue-500/10 hover:bg-blue-500/20 transition-colors group">
										<div class="w-10 h-10 rounded-full bg-blue-500/20 flex items-center justify-center group-hover:scale-110 transition-transform">
											<svg class="w-5 h-5 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
												<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
											</svg>
										</div>
										<span class="font-medium text-foreground">Browse Skills</span>
									</a>
									<a href="/messages" class="flex items-center gap-3 p-4 rounded-lg bg-purple-500/10 hover:bg-purple-500/20 transition-colors group">
										<div class="w-10 h-10 rounded-full bg-purple-500/20 flex items-center justify-center group-hover:scale-110 transition-transform">
											<svg class="w-5 h-5 text-purple-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
												<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path>
											</svg>
										</div>
										<span class="font-medium text-foreground">Messages</span>
									</a>
								</div>
							</div>
							<!-- Recent Activity -->
							<div class="glass-card rounded-xl p-6 animate-fade-in-up delay-200">
								<div class="flex items-center justify-between mb-4">
									<h2 class="text-lg font-semibold text-foreground">Recent Activity</h2>
									<a href="/activity" class="text-sm text-primary hover:underline">View all</a>
								</div>
								<div class="space-y-4">
									@activityItem("Sarah M.", "wants to learn Python from you", "2 hours ago", "match")
									@activityItem("Alex K.", "completed a session with you", "Yesterday", "session")
									@activityItem("Maria G.", "sent you a message", "2 days ago", "message")
									@activityItem("System", "Your profile was viewed 15 times this week", "3 days ago", "info")
								</div>
							</div>
						</div>
						<!-- Right Column - Matches & Recommendations -->
						<div class="space-y-6">
							<!-- Suggested Matches -->
							<div class="glass-card rounded-xl p-6 animate-fade-in-up delay-300">
								<div class="flex items-center justify-between mb-4">
									<h2 class="text-lg font-semibold text-foreground">Top Matches</h2>
									<a href="/matches" class="text-sm text-primary hover:underline">See all</a>
								</div>
								<div class="space-y-3">
									@matchCard("Emily Chen", "Python, Data Science", "98%", "/avatars/1.jpg")
									@matchCard("Marcus Johnson", "Guitar, Music Theory", "94%", "/avatars/2.jpg")
									@matchCard("Sofia Rodriguez", "Spanish, Portuguese", "91%", "/avatars/3.jpg")
								</div>
							</div>
							<!-- Profile Completion -->
							<div class="glass-card rounded-xl p-6 animate-fade-in-up delay-400">
								<h2 class="text-lg font-semibold text-foreground mb-4">Profile Strength</h2>
								<div class="relative pt-1">
									<div class="flex items-center justify-between mb-2">
										<span class="text-sm font-medium text-foreground">65% Complete</span>
										<span class="text-xs text-muted-foreground">+35% to unlock all features</span>
									</div>
									<div class="overflow-hidden h-2 rounded-full bg-muted">
										<div class="h-full rounded-full bg-gradient-to-r from-primary to-accent" style="width: 65%"></div>
									</div>
								</div>
								<div class="mt-4 space-y-2">
									<div class="flex items-center gap-2 text-sm text-muted-foreground">
										<svg class="w-4 h-4 text-emerald-500" fill="currentColor" viewBox="0 0 20 20">
											<path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
										</svg>
										Add profile photo
									</div>
									<div class="flex items-center gap-2 text-sm text-muted-foreground">
										<svg class="w-4 h-4 text-emerald-500" fill="currentColor" viewBox="0 0 20 20">
											<path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
										</svg>
										Add bio
									</div>
									<div class="flex items-center gap-2 text-sm text-foreground">
										<svg class="w-4 h-4 text-border" fill="currentColor" viewBox="0 0 20 20">
											<path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-11a1 1 0 10-2 0v2H7a1 1 0 100 2h2v2a1 1 0 102 0v-2h2a1 1 0 100-2h-2V7z" clip-rule="evenodd"></path>
										</svg>
										Add 3+ skills you can teach
									</div>
									<div class="flex items-center gap-2 text-sm text-foreground">
										<svg class="w-4 h-4 text-border" fill="currentColor" viewBox="0 0 20 20">
											<path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-11a1 1 0 10-2 0v2H7a1 1 0 100 2h2v2a1 1 0 102 0v-2h2a1 1 0 100-2h-2V7z" clip-rule="evenodd"></path>
										</svg>
										Complete your first exchange
									</div>
								</div>
								<a href="/profile" class="btn btn-outline w-full mt-4">
									Complete Profile
								</a>
							</div>
						</div>
					</div>
				</div>
			</main>
			@components.Footer()
		</div>
	}
}

templ statCard(title string, value string, colorClass string, icon templ.Component) {
	<div class="glass-card rounded-xl p-5 animate-fade-in-up">
		<div class="flex items-center justify-between">
			<div>
				<p class="text-sm text-muted-foreground mb-1">{ title }</p>
				<p class={ "text-2xl font-bold", colorClass }>{ value }</p>
			</div>
			<div class={ "w-12 h-12 rounded-full flex items-center justify-center", colorClass + "/10" }>
				@icon
			</div>
		</div>
	</div>
}

templ skillsOfferedIcon() {
	<svg class="w-6 h-6 text-emerald-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
		<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
	</svg>
}

templ skillsWantedIcon() {
	<svg class="w-6 h-6 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
		<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
	</svg>
}

templ matchesIcon() {
	<svg class="w-6 h-6 text-amber-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
		<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
	</svg>
}

templ sessionsIcon() {
	<svg class="w-6 h-6 text-purple-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
		<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
	</svg>
}

templ activityItem(name string, action string, time string, activityType string) {
	<div class="flex items-start gap-3 p-3 rounded-lg hover:bg-muted/50 transition-colors">
		@activityIcon(activityType)
		<div class="flex-1 min-w-0">
			<p class="text-sm text-foreground">
				<span class="font-medium">{ name }</span> { action }
			</p>
			<p class="text-xs text-muted-foreground">{ time }</p>
		</div>
	</div>
}

templ activityIcon(activityType string) {
	switch activityType {
		case "match":
			<div class="w-8 h-8 rounded-full bg-amber-500/10 flex items-center justify-center flex-shrink-0">
				<svg class="w-4 h-4 text-amber-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path>
				</svg>
			</div>
		case "session":
			<div class="w-8 h-8 rounded-full bg-emerald-500/10 flex items-center justify-center flex-shrink-0">
				<svg class="w-4 h-4 text-emerald-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
				</svg>
			</div>
		case "message":
			<div class="w-8 h-8 rounded-full bg-blue-500/10 flex items-center justify-center flex-shrink-0">
				<svg class="w-4 h-4 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path>
				</svg>
			</div>
		default:
			<div class="w-8 h-8 rounded-full bg-muted flex items-center justify-center flex-shrink-0">
				<svg class="w-4 h-4 text-muted-foreground" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
				</svg>
			</div>
	}
}

templ matchCard(name string, skills string, matchPercent string, avatar string) {
	<a href="#" class="flex items-center gap-3 p-3 rounded-lg hover:bg-muted/50 transition-colors group">
		<div class="w-10 h-10 rounded-full bg-primary/20 flex items-center justify-center text-primary font-semibold text-sm flex-shrink-0">
			{ string([]rune(name)[0]) }
		</div>
		<div class="flex-1 min-w-0">
			<p class="text-sm font-medium text-foreground truncate group-hover:text-primary transition-colors">{ name }</p>
			<p class="text-xs text-muted-foreground truncate">{ skills }</p>
		</div>
		<div class="text-xs font-semibold text-primary bg-primary/10 px-2 py-1 rounded-full">
			{ matchPercent }
		</div>
	</a>
}
