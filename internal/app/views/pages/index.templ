package pages

import "github.com/FACorreiaa/talentsynapse/internal/app/views/layouts"
import "github.com/FACorreiaa/talentsynapse/internal/app/views/components"

templ Index(isAuthenticated bool, userName string) {
	@layouts.Base("TalentSynapse - Exchange Skills, Grow Together") {
		<div class="min-h-screen flex flex-col bg-background text-foreground">
			@components.Navbar(isAuthenticated, userName, "")
			<main class="flex-1">
				<!-- Hero Section -->
				<section class="hero-gradient min-h-[90vh] flex items-center justify-center relative overflow-hidden">
					<div class="container mx-auto px-4 py-20 relative z-10">
						<div class="max-w-4xl mx-auto text-center">
							<div class="animate-fade-in-up">
								<span class="inline-block px-4 py-2 rounded-full bg-primary/10 text-primary text-sm font-semibold mb-6 border border-primary/20">
									🚀 Join 10,000+ skill exchangers worldwide
								</span>
							</div>
							<h1 class="text-5xl md:text-7xl font-black mb-6 text-foreground animate-fade-in-up delay-100 leading-tight">
								Exchange Skills,
								<br/>
								<span class="text-gradient">Grow Together</span>
							</h1>
							<p class="text-xl md:text-2xl mb-10 text-muted-foreground animate-fade-in-up delay-200 max-w-2xl mx-auto">
								Connect with people who want to learn what you know, and teach what you want to learn. The ultimate peer-to-peer skill exchange platform.
							</p>
							<div class="flex flex-col sm:flex-row gap-4 justify-center animate-fade-in-up delay-300">
								if isAuthenticated {
									<a href="/dashboard" class="btn btn-lg btn-primary btn-glow inline-flex items-center gap-2 px-8 py-4 text-lg">
										<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
											<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path>
										</svg>
										Go to Dashboard
									</a>
								} else {
									<a href="/register" class="btn btn-lg btn-primary btn-glow inline-flex items-center gap-2 px-8 py-4 text-lg">
										<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
											<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
										</svg>
										Start Exchanging - It's Free
									</a>
									<a href="/discover" class="btn btn-lg btn-outline inline-flex items-center gap-2 px-8 py-4 text-lg">
										Explore Skills
										<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
											<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
										</svg>
									</a>
								}
							</div>
						</div>
					</div>
					<!-- Decorative elements -->
					<div class="absolute bottom-0 left-0 right-0 h-24 bg-gradient-to-t from-background to-transparent"></div>
				</section>
				<!-- How It Works Section -->
				<section class="py-24 px-4 bg-background relative">
					<div class="container mx-auto max-w-6xl">
						<div class="text-center mb-16">
							<h2 class="section-heading text-4xl font-bold text-foreground mb-4">How It Works</h2>
							<p class="text-xl text-muted-foreground max-w-2xl mx-auto">
								Three simple steps to start your skill exchange journey
							</p>
						</div>
						<div class="grid md:grid-cols-3 gap-8 relative">
							<!-- Connecting line (desktop only) -->
							<div class="hidden md:block absolute top-24 left-1/4 right-1/4 h-0.5 bg-gradient-to-r from-primary via-accent to-primary"></div>
							@howItWorksCard("1", "Create Your Profile", "List the skills you can teach and the skills you want to learn. Our AI matches you with the perfect partners.", createProfileIcon())
							@howItWorksCard("2", "Find Your Match", "Browse recommended matches or search for specific skills. Connect with learners and teachers worldwide.", findMatchIcon())
							@howItWorksCard("3", "Exchange & Grow", "Schedule sessions, chat in real-time, and exchange knowledge. Track your progress and earn badges.", exchangeGrowIcon())
						</div>
					</div>
				</section>
				<!-- Categories Section -->
				<section class="py-24 px-4 bg-muted/30 pattern-dots">
					<div class="container mx-auto max-w-6xl">
						<div class="text-center mb-16">
							<h2 class="section-heading text-4xl font-bold text-foreground mb-4">Explore Skill Categories</h2>
							<p class="text-xl text-muted-foreground max-w-2xl mx-auto">
								From tech to arts, languages to fitness - find your passion
							</p>
						</div>
						<div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
							@categoryCard("Technology", "Programming, Web Dev, AI/ML, Data Science, Mobile Apps", "💻", "3,420")
							@categoryCard("Languages", "Spanish, Mandarin, French, Japanese, Arabic, Sign Language", "🌍", "2,890")
							@categoryCard("Creative Arts", "Music, Photography, Design, Writing, Video Editing", "🎨", "2,150")
							@categoryCard("Professional", "Marketing, Finance, Leadership, Public Speaking", "💼", "1,780")
							@categoryCard("Health & Fitness", "Yoga, Nutrition, Personal Training, Meditation", "💪", "1,560")
							@categoryCard("Hobbies", "Cooking, Gardening, Chess, Crafts, Gaming", "🎯", "1,240")
						</div>
					</div>
				</section>
				<!-- Stats Section -->
				<section class="py-20 px-4 bg-gradient-to-br from-primary/10 via-background to-accent/10">
					<div class="container mx-auto max-w-5xl">
						<div class="grid grid-cols-2 md:grid-cols-4 gap-8">
							@statItem("10K+", "Active Users")
							@statItem("500+", "Skills Listed")
							@statItem("50K+", "Exchanges Made")
							@statItem("120+", "Countries")
						</div>
					</div>
				</section>
				<!-- Testimonials Section -->
				<section class="py-24 px-4 bg-background">
					<div class="container mx-auto max-w-6xl">
						<div class="text-center mb-16">
							<h2 class="section-heading text-4xl font-bold text-foreground mb-4">What Our Users Say</h2>
							<p class="text-xl text-muted-foreground max-w-2xl mx-auto">
								Join thousands of happy skill exchangers
							</p>
						</div>
						<div class="grid md:grid-cols-3 gap-6">
							@testimonialCard(
								"TalentSynapse helped me learn Python while teaching Spanish. The matching is incredibly accurate!",
								"Maria Garcia",
								"Software Developer",
								"🇪🇸",
							)
							@testimonialCard(
								"I traded my photography skills for guitar lessons. Now I can play my favorite songs while capturing beautiful moments.",
								"James Chen",
								"Freelance Photographer",
								"🇨🇦",
							)
							@testimonialCard(
								"As a marketing professional, I learned data analytics in exchange for growth hacking tips. Win-win!",
								"Aisha Patel",
								"Marketing Manager",
								"🇬🇧",
							)
						</div>
					</div>
				</section>
				<!-- CTA Section -->
				<section class="py-24 px-4 bg-gradient-to-r from-primary to-accent relative overflow-hidden">
					<div class="absolute inset-0 pattern-grid opacity-10"></div>
					<div class="container mx-auto max-w-4xl text-center relative z-10">
						<h2 class="text-4xl md:text-5xl font-bold text-primary-foreground mb-6">
							Ready to Start Your Journey?
						</h2>
						<p class="text-xl text-primary-foreground/90 mb-10 max-w-2xl mx-auto">
							Join TalentSynapse today and unlock a world of learning and teaching opportunities. It's free to get started!
						</p>
						if !isAuthenticated {
							<a href="/register" class="btn btn-lg bg-white text-primary hover:bg-white/90 inline-flex items-center gap-2 px-10 py-4 text-lg font-bold shadow-xl">
								Create Free Account
								<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
								</svg>
							</a>
						} else {
							<a href="/discover" class="btn btn-lg bg-white text-primary hover:bg-white/90 inline-flex items-center gap-2 px-10 py-4 text-lg font-bold shadow-xl">
								Discover Skills
								<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
								</svg>
							</a>
						}
					</div>
				</section>
			</main>
			@components.Footer()
		</div>
	}
}

templ howItWorksCard(step string, title string, description string, icon templ.Component) {
	<div class="relative text-center animate-fade-in-up">
		<div class="inline-flex items-center justify-center w-20 h-20 rounded-2xl bg-card border border-border shadow-lg mb-6 relative z-10">
			@icon
			<span class="absolute -top-2 -right-2 w-8 h-8 rounded-full bg-primary text-primary-foreground flex items-center justify-center text-sm font-bold">
				{ step }
			</span>
		</div>
		<h3 class="text-xl font-bold text-foreground mb-3">{ title }</h3>
		<p class="text-muted-foreground">{ description }</p>
	</div>
}

templ createProfileIcon() {
	<svg class="w-10 h-10 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
		<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
	</svg>
}

templ findMatchIcon() {
	<svg class="w-10 h-10 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
		<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path>
	</svg>
}

templ exchangeGrowIcon() {
	<svg class="w-10 h-10 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
		<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"></path>
	</svg>
}

templ categoryCard(title string, description string, emoji string, count string) {
	<a href={ templ.SafeURL("/discover?category=" + title) } class="group">
		<div class="glass-card glow-card rounded-xl p-6 h-full cursor-pointer">
			<div class="flex items-start justify-between mb-4">
				<span class="text-4xl">{ emoji }</span>
				<span class="text-sm text-muted-foreground bg-muted px-2 py-1 rounded-full">{ count } skills</span>
			</div>
			<h3 class="text-xl font-bold text-foreground mb-2 group-hover:text-primary transition-colors">{ title }</h3>
			<p class="text-sm text-muted-foreground">{ description }</p>
		</div>
	</a>
}

templ statItem(value string, label string) {
	<div class="text-center animate-fade-in-up">
		<div class="stat-value">{ value }</div>
		<div class="stat-label">{ label }</div>
	</div>
}

templ testimonialCard(quote string, name string, role string, flag string) {
	<div class="glass-card rounded-xl p-6 h-full animate-fade-in-up">
		<div class="flex gap-1 text-amber-400 mb-4">
			<svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path></svg>
			<svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path></svg>
			<svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path></svg>
			<svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path></svg>
			<svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path></svg>
		</div>
		<p class="text-foreground mb-6 italic">\"{ quote }\"</p>
		<div class="flex items-center gap-3">
			<div class="w-12 h-12 rounded-full bg-primary/20 flex items-center justify-center text-primary font-bold">
				{ string([]rune(name)[0]) }
			</div>
			<div>
				<p class="font-semibold text-foreground">{ name } { flag }</p>
				<p class="text-sm text-muted-foreground">{ role }</p>
			</div>
		</div>
	</div>
}
