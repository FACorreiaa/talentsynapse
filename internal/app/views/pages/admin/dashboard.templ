package adminpages

import (
	"fmt"
	"github.com/FACorreiaa/skillsphere/internal/app/domain/user"
	components "github.com/FACorreiaa/skillsphere/internal/app/views/components"
	layouts "github.com/FACorreiaa/skillsphere/internal/app/views/layouts"
)

templ Dashboard(users []*user.User) {
	@layouts.Base("Admin Dashboard") {
		@components.Navbar(true, "Admin", "")
		<div class="container mx-auto px-4 py-8">
			<div class="flex justify-between items-center mb-6">
				<h1 class="text-3xl font-bold text-gray-900 dark:text-gray-100">Admin Dashboard</h1>
				<div class="text-sm text-gray-500">
					Total Users: { fmt.Sprint(len(users)) }
				</div>
			</div>
			<div class="bg-white dark:bg-gray-800 shadow-md rounded-lg overflow-hidden">
				<div class="overflow-x-auto">
					<table class="min-w-full divide-y divide-gray-200 dark:divide-gray-700">
						<thead class="bg-gray-50 dark:bg-gray-900">
							<tr>
								<th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider">User</th>
								<th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider">Role</th>
								<th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider">Status</th>
								<th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider">Joined</th>
								<th scope="col" class="px-6 py-3 text-right text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider">Actions</th>
							</tr>
						</thead>
						<tbody class="bg-white dark:bg-gray-800 divide-y divide-gray-200 dark:divide-gray-700">
							for _, u := range users {
								<tr>
									<td class="px-6 py-4 whitespace-nowrap">
										<div class="flex items-center">
											<div class="flex-shrink-0 h-10 w-10">
												if u.AvatarURL != nil && *u.AvatarURL != "" {
													<img class="h-10 w-10 rounded-full object-cover" src={ *u.AvatarURL } alt={ u.DisplayName }/>
												} else {
													<div class="h-10 w-10 rounded-full bg-brand-orange-500 flex items-center justify-center text-white font-bold">
														{ string(u.DisplayName[0]) }
													</div>
												}
											</div>
											<div class="ml-4">
												<div class="text-sm font-medium text-gray-900 dark:text-gray-100">{ u.DisplayName }</div>
												<div class="text-sm text-gray-500 dark:text-gray-400">{ u.Email }</div>
												<div class="text-xs text-gray-400">{ "@" + u.Username }</div>
											</div>
										</div>
									</td>
									<td class="px-6 py-4 whitespace-nowrap">
										<span class={ GetRoleBadgeClass(u.Role) }>
											{ u.Role }
										</span>
									</td>
									<td class="px-6 py-4 whitespace-nowrap">
										if u.IsActive {
											<span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-green-100 text-green-800 dark:bg-green-900 dark:text-green-200">
												Active
											</span>
										} else {
											<span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-red-100 text-red-800 dark:bg-red-900 dark:text-red-200">
												Banned
											</span>
										}
									</td>
									<td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500 dark:text-gray-400">
										{ u.CreatedAt.Format("Jan 02, 2006") }
									</td>
									<td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
										if u.Role != "admin" {
											<div class="flex justify-end gap-2">
												// Ban/Unban Button
												if u.IsActive {
													<form action={ templ.SafeURL(fmt.Sprintf("/admin/users/%s/ban", u.ID)) } method="POST" onsubmit="return confirm('Are you sure you want to BAN this user?');">
														<input type="hidden" name="action" value="ban"/>
														<button type="submit" class="text-red-600 hover:text-red-900 dark:hover:text-red-400">Ban</button>
													</form>
												} else {
													<form action={ templ.SafeURL(fmt.Sprintf("/admin/users/%s/ban", u.ID)) } method="POST">
														<input type="hidden" name="action" value="unban"/>
														<button type="submit" class="text-green-600 hover:text-green-900 dark:hover:text-green-400">Unban</button>
													</form>
												}
												// Verify/Unverify Button (using 'expert' role for now as per handler)
												if u.Role == "member" {
													<form action={ templ.SafeURL(fmt.Sprintf("/admin/users/%s/verify", u.ID)) } method="POST">
														<input type="hidden" name="action" value="verify"/>
														<button type="submit" class="text-blue-600 hover:text-blue-900 dark:hover:text-blue-400">Verify</button>
													</form>
												} else if u.Role == "expert" {
													<form action={ templ.SafeURL(fmt.Sprintf("/admin/users/%s/verify", u.ID)) } method="POST">
														<input type="hidden" name="action" value="unverify"/>
														<button type="submit" class="text-gray-600 hover:text-gray-900 dark:hover:text-gray-400">Unverify</button>
													</form>
												}
											</div>
										}
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			</div>
		</div>
	}
}
