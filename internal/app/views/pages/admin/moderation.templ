package adminpages

import (
	"fmt"
	"github.com/FACorreiaa/talentsynapse/internal/app/domain/report"
	"github.com/FACorreiaa/talentsynapse/internal/app/views/layouts"
)

templ Moderation(reports []*report.Report) {
	@layouts.AppLayout("Moderation Queue", true, "Admin", "") {
		@ModerationContent(reports)
	}
}

// ModerationContent renders just the main content (for HTMX partial swaps)
templ ModerationContent(reports []*report.Report) {
	<div class="container mx-auto px-4 py-8">
		<div class="flex justify-between items-center mb-6">
			<h1 class="text-3xl font-bold text-gray-900 dark:text-gray-100">Moderation Queue</h1>
			<div class="text-sm text-gray-500">
				Pending Reports: { fmt.Sprint(len(reports)) }
			</div>
			<div class="space-x-2">
				<a href="/admin" class="text-gray-600 hover:text-gray-900 dark:text-gray-400 dark:hover:text-white">Back to Dashboard</a>
			</div>
		</div>
		<div class="bg-white dark:bg-gray-800 shadow-md rounded-lg overflow-hidden">
			if len(reports) == 0 {
				<div class="p-8 text-center text-gray-500 dark:text-gray-400">
					No pending reports. Great job!
				</div>
			} else {
				<div class="overflow-x-auto">
					<table class="min-w-full divide-y divide-gray-200 dark:divide-gray-700">
						<thead class="bg-gray-50 dark:bg-gray-900">
							<tr>
								<th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider">Reporter</th>
								<th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider">Reported User</th>
								<th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider">Type</th>
								<th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider">Description</th>
								<th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider">Date</th>
								<th scope="col" class="px-6 py-3 text-right text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider">Actions</th>
							</tr>
						</thead>
						<tbody class="bg-white dark:bg-gray-800 divide-y divide-gray-200 dark:divide-gray-700">
							for _, r := range reports {
								<tr>
									<td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900 dark:text-gray-100">
										{ r.ReporterName }
									</td>
									<td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900 dark:text-gray-100">
										{ r.ReportedUserName }
									</td>
									<td class="px-6 py-4 whitespace-nowrap">
										<span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-yellow-100 text-yellow-800 dark:bg-yellow-900 dark:text-yellow-200">
											{ string(r.ReportType) }
										</span>
									</td>
									<td class="px-6 py-4 text-sm text-gray-500 dark:text-gray-400 max-w-xs truncate" title={ r.Description }>
										{ r.Description }
									</td>
									<td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500 dark:text-gray-400">
										{ r.CreatedAt.Format("Jan 02, 15:04") }
									</td>
									<td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
										<div class="flex justify-end gap-2">
											// Dismiss Form
											<form action={ templ.SafeURL(fmt.Sprintf("/admin/reports/%s/resolve", r.ID)) } method="POST">
												<input type="hidden" name="action" value="dismiss"/>
												<button type="submit" class="text-gray-600 hover:text-gray-900 dark:hover:text-gray-300">Dismiss</button>
											</form>
											// Ban Form
											<form action={ templ.SafeURL(fmt.Sprintf("/admin/reports/%s/resolve", r.ID)) } method="POST" onsubmit="return confirm('Ban user and resolve report?');">
												<input type="hidden" name="action" value="ban"/>
												<input type="hidden" name="reported_user_id" value={ r.ReportedUserID.String() }/>
												<button type="submit" class="text-red-600 hover:text-red-900 dark:hover:text-red-400">Ban User</button>
											</form>
										</div>
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			}
		</div>
	</div>
}
