package connections

import (
	"github.com/FACorreiaa/skillsphere/internal/app/views/components"
	"github.com/FACorreiaa/skillsphere/internal/app/views/layouts"
	"strconv"
)

// ConnectionCard represents a connected user for display
type ConnectionCard struct {
	UserID      string
	DisplayName string
	Username    string
	AvatarURL   string
	Bio         string
}

templ Connections(connections []ConnectionCard, userName string, userAvatar string) {
	@layouts.Base("Connections | SkillSphere") {
		<div class="min-h-screen flex flex-col bg-background">
			@components.Navbar(true, userName, userAvatar)
			<main class="flex-1 py-8 px-4">
				<div class="container mx-auto max-w-5xl">
					<!-- Page Header -->
					<div class="mb-8 animate-fade-in-up">
						<h1 class="text-3xl md:text-4xl font-bold text-foreground mb-2">
							My <span class="text-gradient">Connections</span>
						</h1>
						<p class="text-muted-foreground">
							People you've connected with for skill exchanges
						</p>
					</div>
					<!-- Connections Grid -->
					if len(connections) == 0 {
						@emptyConnections()
					} else {
						<div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
							for i, conn := range connections {
								@connectionCard(conn, i)
							}
						</div>
					}
				</div>
			</main>
			@components.Footer()
		</div>
	}
}

templ connectionCard(conn ConnectionCard, index int) {
	<div
		class="glass-card rounded-2xl p-6 flex flex-col items-center text-center animate-fade-in-up hover:ring-2 hover:ring-primary/50 transition-all duration-300"
		style={ "animation-delay: " + strconv.Itoa(index*50) + "ms" }
	>
		<!-- Avatar -->
		<div class="relative mb-4">
			if conn.AvatarURL != "" {
				<img
					src={ conn.AvatarURL }
					alt={ conn.DisplayName }
					class="w-20 h-20 rounded-full object-cover ring-4 ring-primary/20"
				/>
			} else {
				<div class="w-20 h-20 rounded-full bg-gradient-to-br from-primary to-accent flex items-center justify-center text-primary-foreground text-2xl font-bold">
					{ getInitial(conn.DisplayName) }
				</div>
			}
			<span class="absolute bottom-0 right-0 w-5 h-5 bg-emerald-500 rounded-full border-2 border-background"></span>
		</div>
		<!-- Info -->
		<h3 class="text-lg font-semibold text-foreground mb-1">{ conn.DisplayName }</h3>
		<p class="text-sm text-muted-foreground mb-2">{ "@" + conn.Username }</p>
		if conn.Bio != "" {
			<p class="text-sm text-muted-foreground mb-4 line-clamp-2">{ conn.Bio }</p>
		}
		<!-- Actions -->
		<div class="flex gap-2 mt-auto w-full">
			<a
				href={ templ.SafeURL("/chat/start/" + conn.UserID) }
				class="flex-1 btn btn-primary btn-glow text-sm"
			>
				<svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path>
				</svg>
				Chat
			</a>
			<a
				href={ templ.SafeURL("/users/" + conn.UserID) }
				class="btn btn-outline text-sm"
			>
				<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
				</svg>
			</a>
		</div>
	</div>
}

templ emptyConnections() {
	<div class="glass-card rounded-2xl p-12 text-center animate-fade-in-up max-w-xl mx-auto">
		<div class="w-20 h-20 mx-auto mb-6 rounded-full bg-muted flex items-center justify-center">
			<svg class="w-10 h-10 text-muted-foreground" fill="none" stroke="currentColor" viewBox="0 0 24 24">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
			</svg>
		</div>
		<h2 class="text-xl font-bold text-foreground mb-2">No Connections Yet</h2>
		<p class="text-muted-foreground mb-6 max-w-md mx-auto">
			When you and another user both accept each other on the Matches page, you'll become connected and can start chatting.
		</p>
		<a href="/matches" class="btn btn-primary btn-glow">
			<svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
			</svg>
			Find Matches
		</a>
	</div>
}

func getInitial(name string) string {
	if len(name) == 0 {
		return "?"
	}
	runes := []rune(name)
	return string(runes[0])
}
