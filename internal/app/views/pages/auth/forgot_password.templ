package auth

import "github.com/FACorreiaa/skillsphere/internal/app/views/layouts"
import "github.com/FACorreiaa/skillsphere/internal/app/views/components"

templ ForgotPassword(errorMsg string, successMsg string) {
	@layouts.Base("Reset Password | SkillSphere") {
		<div class="min-h-screen flex flex-col bg-background">
			@components.Navbar(false, "", "")
			<main class="flex-1 flex items-center justify-center py-12 px-4">
				<div class="w-full max-w-md">
					<div class="bg-card rounded-2xl shadow-2xl p-8 md:p-10 animate-scale-in">
						<!-- Flash Messages -->
						if errorMsg != "" {
							@components.FlashMessage(errorMsg, "error")
						}
						if successMsg != "" {
							@components.FlashMessage(successMsg, "success")
						}
						<!-- Icon -->
						<div class="flex justify-center mb-6">
							<div class="w-16 h-16 rounded-full bg-primary/10 flex items-center justify-center">
								<svg class="w-8 h-8 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"></path>
								</svg>
							</div>
						</div>
						<div class="text-center mb-8">
							<h1 class="text-2xl font-bold text-foreground mb-2">Forgot Password?</h1>
							<p class="text-muted-foreground text-sm">
								No worries! Enter your email address and we'll send you a link to reset your password.
							</p>
						</div>
						<form action="/forgot-password" method="POST" class="space-y-5">
							<!-- Email Field -->
							<div class="space-y-2">
								<label for="email" class="text-sm font-medium text-foreground">Email Address</label>
								<input
									type="email"
									id="email"
									name="email"
									placeholder="you@example.com"
									required
									class="input w-full"
									autocomplete="email"
								/>
							</div>
							<!-- Submit Button -->
							<button type="submit" class="btn btn-primary w-full py-3 text-base font-semibold">
								Send Reset Link
							</button>
						</form>
						<!-- Back to Login -->
						<div class="mt-8 text-center">
							<a href="/login" class="inline-flex items-center gap-2 text-sm text-muted-foreground hover:text-foreground transition-colors">
								<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
								</svg>
								Back to Sign In
							</a>
						</div>
					</div>
					<!-- Security Note -->
					<p class="text-center text-xs text-muted-foreground mt-6">
						For security reasons, we won't tell you if an email exists. If you don't receive an email within a few minutes, check your spam folder or try again.
					</p>
				</div>
			</main>
			@components.Footer()
		</div>
	}
}
