package matches

import "github.com/FACorreiaa/talentsynapse/internal/app/views/layouts"
import "github.com/FACorreiaa/talentsynapse/internal/app/views/components"
import "strconv"

// MatchCard represents a potential match for display
type MatchCard struct {
	UserID        string
	DisplayName   string
	Username      string
	AvatarURL     string
	MatchScore    int // percentage 0-100
	OverlapSkills []SkillOverlap
	IsLikedYou    bool // true if this user has already liked the current user
}

// SkillOverlap represents a shared skill interest
type SkillOverlap struct {
	Name      string
	TheyTeach bool // true = they can teach you, false = you can teach them
}

// ConnectionCard represents a confirmed mutual match
type ConnectionCard struct {
	UserID      string
	DisplayName string
	Username    string
	AvatarURL   string
	Bio         string
}

// PendingCard represents a user you've liked but who hasn't responded yet
type PendingCard struct {
	UserID      string
	DisplayName string
	Username    string
	AvatarURL   string
}

templ MatchesPage(matches []MatchCard, connections []ConnectionCard, pending []PendingCard, activeTab string, userName string, userAvatar string, successMsg string) {
	@layouts.Base("Matches | TalentSynapse") {
		<div class="min-h-screen flex flex-col bg-background">
			@components.Navbar(true, userName, userAvatar)
			<main class="flex-1 py-8 px-4">
				<div class="container mx-auto max-w-4xl">
					<!-- Flash Messages -->
					if successMsg != "" {
						@components.FlashMessage(successMsg, "success")
					}
					<!-- Page Header -->
					<div class="text-center mb-6 animate-fade-in-up">
						<h1 class="text-3xl md:text-4xl font-bold text-foreground mb-2">
							Find Your <span class="text-gradient">Match</span>
						</h1>
						<p class="text-muted-foreground">
							Discover people who can teach you and learn from you
						</p>
					</div>
					<!-- Tabs -->
					<div class="flex justify-center mb-8">
						<div class="inline-flex bg-muted rounded-xl p-1 flex-wrap gap-1">
							<a
								href="/matches?tab=discover"
								class={ "px-4 py-2 rounded-lg font-medium transition-all duration-200 text-sm",
									templ.KV("bg-background text-foreground shadow-sm", activeTab == "discover"),
									templ.KV("text-muted-foreground hover:text-foreground", activeTab != "discover") }
							>
								<div class="flex items-center gap-1.5">
									<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
									</svg>
									Discover
									if len(matches) > 0 {
										<span class="px-1.5 py-0.5 text-xs bg-primary/20 text-primary rounded-full">
											{ strconv.Itoa(len(matches)) }
										</span>
									}
								</div>
							</a>
							<a
								href="/matches?tab=pending"
								class={ "px-4 py-2 rounded-lg font-medium transition-all duration-200 text-sm",
									templ.KV("bg-background text-foreground shadow-sm", activeTab == "pending"),
									templ.KV("text-muted-foreground hover:text-foreground", activeTab != "pending") }
							>
								<div class="flex items-center gap-1.5">
									<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
									</svg>
									Pending
									if len(pending) > 0 {
										<span class="px-1.5 py-0.5 text-xs bg-yellow-500/20 text-yellow-500 rounded-full">
											{ strconv.Itoa(len(pending)) }
										</span>
									}
								</div>
							</a>
							<a
								href="/matches?tab=connections"
								class={ "px-4 py-2 rounded-lg font-medium transition-all duration-200 text-sm",
									templ.KV("bg-background text-foreground shadow-sm", activeTab == "connections"),
									templ.KV("text-muted-foreground hover:text-foreground", activeTab != "connections") }
							>
								<div class="flex items-center gap-1.5">
									<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
									</svg>
									Connections
									if len(connections) > 0 {
										<span class="px-1.5 py-0.5 text-xs bg-emerald-500/20 text-emerald-500 rounded-full">
											{ strconv.Itoa(len(connections)) }
										</span>
									}
								</div>
							</a>
						</div>
					</div>
					<!-- Tab Content -->
					if activeTab == "discover" {
						@discoverTab(matches)
					} else if activeTab == "pending" {
						@pendingTab(pending)
					} else {
						@connectionsTab(connections)
					}
				</div>
			</main>
			@components.Footer()
		</div>
	}
}

templ discoverTab(matches []MatchCard) {
	<div id="match-stack" class="max-w-3xl mx-auto">
		if len(matches) == 0 {
			@emptyDiscoverState()
		} else {
			for i, match := range matches {
				@matchCard(match, i)
			}
		}
	</div>
}

templ connectionsTab(connections []ConnectionCard) {
	if len(connections) == 0 {
		@emptyConnectionsState()
	} else {
		<div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
			for i, conn := range connections {
				@connectionCard(conn, i)
			}
		</div>
	}
}

templ pendingTab(pending []PendingCard) {
	if len(pending) == 0 {
		@emptyPendingState()
	} else {
		<div class="max-w-3xl mx-auto">
			<div class="glass-card rounded-2xl p-4 mb-4">
				<p class="text-sm text-muted-foreground text-center">
					⏳ These users will appear in your Connections once they accept you back
				</p>
			</div>
			<div class="grid sm:grid-cols-2 gap-4">
				for i, p := range pending {
					@pendingCard(p, i)
				}
			</div>
		</div>
	}
}

templ pendingCard(p PendingCard, index int) {
	<div
		class="glass-card rounded-xl p-4 flex items-center gap-4 animate-fade-in-up"
		style={ "animation-delay: " + strconv.Itoa(index*50) + "ms" }
	>
		<!-- Avatar -->
		if p.AvatarURL != "" {
			<img
				src={ p.AvatarURL }
				alt={ p.DisplayName }
				class="w-12 h-12 rounded-full object-cover ring-2 ring-yellow-500/30"
			/>
		} else {
			<div class="w-12 h-12 rounded-full bg-gradient-to-br from-yellow-500 to-orange-500 flex items-center justify-center text-white text-lg font-bold">
				{ getInitial(p.DisplayName) }
			</div>
		}
		<!-- Info -->
		<div class="flex-1 min-w-0">
			<h3 class="font-semibold text-foreground truncate">{ p.DisplayName }</h3>
			<p class="text-sm text-muted-foreground truncate">{ "@" + p.Username }</p>
		</div>
		<!-- Status -->
		<div class="flex items-center gap-2">
			<span class="px-2 py-1 text-xs bg-yellow-500/20 text-yellow-500 rounded-full whitespace-nowrap">
				Waiting...
			</span>
			<a
				href={ templ.SafeURL("/users/" + p.UserID) }
				class="btn btn-ghost btn-sm"
			>
				<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
				</svg>
			</a>
		</div>
	</div>
}

templ emptyPendingState() {
	<div class="glass-card rounded-2xl p-12 text-center animate-fade-in-up max-w-xl mx-auto">
		<div class="w-20 h-20 mx-auto mb-6 rounded-full bg-muted flex items-center justify-center">
			<svg class="w-10 h-10 text-muted-foreground" fill="none" stroke="currentColor" viewBox="0 0 24 24">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
			</svg>
		</div>
		<h2 class="text-xl font-bold text-foreground mb-2">No Pending Matches</h2>
		<p class="text-muted-foreground mb-6 max-w-md mx-auto">
			When you connect with someone, they'll appear here until they accept you back.
		</p>
		<a href="/matches?tab=discover" class="btn btn-primary btn-glow">
			<svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
			</svg>
			Discover Matches
		</a>
	</div>
}

templ connectionCard(conn ConnectionCard, index int) {
	<div
		class="glass-card rounded-2xl p-6 flex flex-col items-center text-center animate-fade-in-up hover:ring-2 hover:ring-primary/50 transition-all duration-300"
		style={ "animation-delay: " + strconv.Itoa(index*50) + "ms" }
	>
		<!-- Avatar -->
		<div class="relative mb-4">
			if conn.AvatarURL != "" {
				<img
					src={ conn.AvatarURL }
					alt={ conn.DisplayName }
					class="w-20 h-20 rounded-full object-cover ring-4 ring-primary/20"
				/>
			} else {
				<div class="w-20 h-20 rounded-full bg-gradient-to-br from-primary to-accent flex items-center justify-center text-primary-foreground text-2xl font-bold">
					{ getInitial(conn.DisplayName) }
				</div>
			}
			<span class="absolute bottom-0 right-0 w-5 h-5 bg-emerald-500 rounded-full border-2 border-background"></span>
		</div>
		<!-- Info -->
		<h3 class="text-lg font-semibold text-foreground mb-1">{ conn.DisplayName }</h3>
		<p class="text-sm text-muted-foreground mb-2">{ "@" + conn.Username }</p>
		if conn.Bio != "" {
			<p class="text-sm text-muted-foreground mb-4 line-clamp-2">{ truncateBio(conn.Bio, 80) }</p>
		}
		<!-- Actions -->
		<div class="flex gap-2 mt-auto w-full">
			<a
				href={ templ.SafeURL("/chat/start/" + conn.UserID) }
				class="flex-1 btn btn-primary btn-glow text-sm"
			>
				<svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path>
				</svg>
				Message
			</a>
			<a
				href={ templ.SafeURL("/users/" + conn.UserID) }
				class="btn btn-outline text-sm"
			>
				<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
				</svg>
			</a>
		</div>
	</div>
}

templ matchCard(match MatchCard, index int) {
	<div
		id={ "match-" + match.UserID }
		class="glass-card rounded-2xl p-6 mb-4 animate-fade-in-up transition-all duration-300"
		style={ "animation-delay: " + strconv.Itoa(index*50) + "ms" }
	>
		<!-- Header -->
		<div class="flex items-start justify-between mb-6">
			<div class="flex items-center gap-4">
				<!-- Avatar -->
				if match.AvatarURL != "" {
					<img
						src={ match.AvatarURL }
						alt={ match.DisplayName }
						class="w-16 h-16 rounded-full object-cover ring-4 ring-primary/20"
					/>
				} else {
					<div class="w-16 h-16 rounded-full bg-gradient-to-br from-primary to-accent flex items-center justify-center text-primary-foreground text-2xl font-bold">
						{ getInitial(match.DisplayName) }
					</div>
				}
				<!-- Info -->
				<div>
					<div class="flex items-center gap-2">
						<h2 class="text-xl font-bold text-foreground">{ match.DisplayName }</h2>
						if match.IsLikedYou {
							<span class="px-2 py-0.5 text-xs font-semibold bg-pink-500/20 text-pink-400 rounded-full animate-pulse">
								💕 Liked You
							</span>
						}
					</div>
					<p class="text-sm text-muted-foreground">{ "@" + match.Username }</p>
				</div>
			</div>
			<!-- Match Score -->
			<div class="text-right">
				<div class="text-2xl font-bold text-primary">{ strconv.Itoa(match.MatchScore) }%</div>
				<div class="text-xs text-muted-foreground">match</div>
			</div>
		</div>
		<!-- Skill Overlap -->
		<div class="mb-6">
			<h3 class="text-sm font-medium text-foreground mb-3">Skill Exchange</h3>
			<div class="space-y-2">
				for _, skill := range match.OverlapSkills {
					<div class="flex items-center gap-2 text-sm">
						if skill.TheyTeach {
							<span class="w-6 h-6 rounded-full bg-blue-500/10 flex items-center justify-center">
								<svg class="w-3 h-3 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
								</svg>
							</span>
							<span class="text-muted-foreground">They can teach you</span>
							<span class="font-medium text-foreground">{ skill.Name }</span>
						} else {
							<span class="w-6 h-6 rounded-full bg-emerald-500/10 flex items-center justify-center">
								<svg class="w-3 h-3 text-emerald-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 10l7-7m0 0l7 7m-7-7v18"></path>
								</svg>
							</span>
							<span class="text-muted-foreground">You can teach them</span>
							<span class="font-medium text-foreground">{ skill.Name }</span>
						}
					</div>
				}
			</div>
		</div>
		<!-- Action Buttons -->
		<div class="flex gap-4">
			<button
				class="flex-1 btn btn-outline border-destructive text-destructive hover:bg-destructive hover:text-destructive-foreground transition-all"
				hx-post={ "/matches/" + match.UserID + "/reject" }
				hx-target={ "#match-" + match.UserID }
				hx-swap="outerHTML"
			>
				<svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
				</svg>
				Skip
			</button>
			<button
				class="flex-1 btn btn-primary btn-glow transition-all"
				hx-post={ "/matches/" + match.UserID + "/accept" }
				hx-target={ "#match-" + match.UserID }
				hx-swap="outerHTML"
			>
				<svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
				</svg>
				Connect
			</button>
		</div>
	</div>
}

templ emptyDiscoverState() {
	<div class="glass-card rounded-2xl p-12 text-center animate-fade-in-up">
		<div class="w-20 h-20 mx-auto mb-6 rounded-full bg-muted flex items-center justify-center">
			<svg class="w-10 h-10 text-muted-foreground" fill="none" stroke="currentColor" viewBox="0 0 24 24">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
			</svg>
		</div>
		<h2 class="text-xl font-bold text-foreground mb-2">No New Matches</h2>
		<p class="text-muted-foreground mb-6 max-w-md mx-auto">
			You've seen all available matches! Add more skills to your profile to find new people, or check your connections.
		</p>
		<div class="flex gap-4 justify-center">
			<a href="/skills" class="btn btn-primary btn-glow">
				Add Skills
			</a>
			<a href="/matches?tab=connections" class="btn btn-outline">
				View Connections
			</a>
		</div>
	</div>
}

templ emptyConnectionsState() {
	<div class="glass-card rounded-2xl p-12 text-center animate-fade-in-up max-w-xl mx-auto">
		<div class="w-20 h-20 mx-auto mb-6 rounded-full bg-muted flex items-center justify-center">
			<svg class="w-10 h-10 text-muted-foreground" fill="none" stroke="currentColor" viewBox="0 0 24 24">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
			</svg>
		</div>
		<h2 class="text-xl font-bold text-foreground mb-2">No Connections Yet</h2>
		<p class="text-muted-foreground mb-6 max-w-md mx-auto">
			When you and another user both accept each other, you'll become connected and can start chatting!
		</p>
		<a href="/matches?tab=discover" class="btn btn-primary btn-glow">
			<svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
			</svg>
			Find Matches
		</a>
	</div>
}

// Keep old Matches function for backwards compatibility
templ Matches(matches []MatchCard, userName string, userAvatar string, successMsg string) {
	@MatchesPage(matches, nil, nil, "discover", userName, userAvatar, successMsg)
}

func getInitial(name string) string {
	if len(name) == 0 {
		return "?"
	}
	runes := []rune(name)
	return string(runes[0])
}

func truncateBio(s string, maxLen int) string {
	if len(s) <= maxLen {
		return s
	}
	return s[:maxLen-3] + "..."
}
