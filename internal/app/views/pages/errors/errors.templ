package errors

import "github.com/FACorreiaa/skillsphere/internal/app/views/layouts"

templ NotFound() {
	@layouts.Base("Page Not Found | SkillSphere") {
		<div class="min-h-screen flex flex-col bg-background">
			<main class="flex-1 flex items-center justify-center px-4">
				<div class="text-center animate-fade-in-up">
					<!-- 404 Illustration -->
					<div class="mb-8">
						<div class="relative inline-block">
							<span class="text-[12rem] md:text-[16rem] font-bold text-gradient opacity-20 select-none">404</span>
							<div class="absolute inset-0 flex items-center justify-center">
								<div class="w-32 h-32 rounded-full bg-primary/10 flex items-center justify-center">
									<svg class="w-16 h-16 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
									</svg>
								</div>
							</div>
						</div>
					</div>
					<!-- Message -->
					<h1 class="text-3xl md:text-4xl font-bold text-foreground mb-4">
						Page Not Found
					</h1>
					<p class="text-lg text-muted-foreground mb-8 max-w-md mx-auto">
						Oops! The page you're looking for doesn't exist or has been moved.
					</p>
					<!-- Actions -->
					<div class="flex flex-col sm:flex-row gap-4 justify-center">
						<a href="/" class="btn btn-primary btn-glow">
							<svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path>
							</svg>
							Go Home
						</a>
						<a href="/discover" class="btn btn-outline">
							<svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
							</svg>
							Discover Skills
						</a>
					</div>
				</div>
			</main>
		</div>
	}
}

templ ServerError(message string) {
	@layouts.Base("Something Went Wrong | SkillSphere") {
		<div class="min-h-screen flex flex-col bg-background">
			<main class="flex-1 flex items-center justify-center px-4">
				<div class="text-center animate-fade-in-up">
					<!-- 500 Illustration -->
					<div class="mb-8">
						<div class="relative inline-block">
							<span class="text-[12rem] md:text-[16rem] font-bold text-destructive/20 select-none">500</span>
							<div class="absolute inset-0 flex items-center justify-center">
								<div class="w-32 h-32 rounded-full bg-destructive/10 flex items-center justify-center">
									<svg class="w-16 h-16 text-destructive" fill="none" stroke="currentColor" viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
									</svg>
								</div>
							</div>
						</div>
					</div>
					<!-- Message -->
					<h1 class="text-3xl md:text-4xl font-bold text-foreground mb-4">
						Something Went Wrong
					</h1>
					<p class="text-lg text-muted-foreground mb-2 max-w-md mx-auto">
						We're sorry, but something unexpected happened.
					</p>
					if message != "" {
						<p class="text-sm text-muted-foreground mb-8 max-w-md mx-auto font-mono bg-muted/50 px-4 py-2 rounded-lg">
							{ message }
						</p>
					} else {
						<p class="text-muted-foreground mb-8">
							Please try again or contact support if the problem persists.
						</p>
					}
					<!-- Actions -->
					<div class="flex flex-col sm:flex-row gap-4 justify-center">
						<button onclick="window.location.reload()" class="btn btn-primary btn-glow">
							<svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
							</svg>
							Try Again
						</button>
						<a href="/" class="btn btn-outline">
							<svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path>
							</svg>
							Go Home
						</a>
					</div>
				</div>
			</main>
		</div>
	}
}

templ Forbidden() {
	@layouts.Base("Access Denied | SkillSphere") {
		<div class="min-h-screen flex flex-col bg-background">
			<main class="flex-1 flex items-center justify-center px-4">
				<div class="text-center animate-fade-in-up">
					<!-- 403 Illustration -->
					<div class="mb-8">
						<div class="relative inline-block">
							<span class="text-[12rem] md:text-[16rem] font-bold text-amber-500/20 select-none">403</span>
							<div class="absolute inset-0 flex items-center justify-center">
								<div class="w-32 h-32 rounded-full bg-amber-500/10 flex items-center justify-center">
									<svg class="w-16 h-16 text-amber-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
									</svg>
								</div>
							</div>
						</div>
					</div>
					<!-- Message -->
					<h1 class="text-3xl md:text-4xl font-bold text-foreground mb-4">
						Access Denied
					</h1>
					<p class="text-lg text-muted-foreground mb-8 max-w-md mx-auto">
						You don't have permission to view this page.
					</p>
					<!-- Actions -->
					<div class="flex flex-col sm:flex-row gap-4 justify-center">
						<a href="/login" class="btn btn-primary btn-glow">
							<svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1"></path>
							</svg>
							Sign In
						</a>
						<a href="/" class="btn btn-outline">
							Go Home
						</a>
					</div>
				</div>
			</main>
		</div>
	}
}
