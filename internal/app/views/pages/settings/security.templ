package settings

import (
	"fmt"
	"github.com/FACorreiaa/talentsynapse/internal/app/types"
	"github.com/FACorreiaa/talentsynapse/internal/app/views/layouts"
)

// SecuritySettingsData contains data for security settings page
type SecuritySettingsData struct {
	MFAEnabled       bool
	BackupCodesCount int
	TrustedDevices   []TrustedDeviceData
}

type TrustedDeviceData struct {
	ID         string
	DeviceName string
	LastUsedAt string
	CreatedAt  string
}

templ SecuritySettings(sessionData types.SessionData, data SecuritySettingsData) {
	@layouts.AppLayout("Security Settings | TalentSynapse", true, sessionData.UserName, sessionData.UserAvatar) {
		@SecuritySettingsContent(data)
	}
}

// SecuritySettingsContent renders just the main content (for HTMX partial swaps)
templ SecuritySettingsContent(data SecuritySettingsData) {
	<div class="py-8 px-4">
		<div class="container mx-auto max-w-3xl">
			<!-- Page Header -->
			<div class="mb-8 animate-fade-in-up">
				<h1 class="text-3xl md:text-4xl font-bold text-foreground mb-2">
					<span class="text-gradient">Security Settings</span>
				</h1>
				<p class="text-muted-foreground">
					Manage your account security and authentication methods
				</p>
			</div>
			<!-- Two-Factor Authentication Section -->
			<div class="glass-card rounded-xl p-6 mb-6 animate-fade-in-up">
				<div class="flex items-start gap-4 mb-6">
					<div class="flex-shrink-0">
						<div class="w-12 h-12 bg-gradient-to-r from-purple-100 to-green-100 rounded-lg flex items-center justify-center">
							<svg class="w-6 h-6 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
							</svg>
						</div>
					</div>
					<div class="flex-1">
						<h2 class="text-xl font-semibold text-foreground mb-2">
							Two-Factor Authentication
						</h2>
						<p class="text-sm text-muted-foreground mb-4">
							Add an extra layer of security to your account by requiring a verification code when you sign in.
						</p>
						if data.MFAEnabled {
							<!-- MFA Enabled State -->
							<div class="bg-green-50 border border-green-200 rounded-lg p-4 mb-4">
								<div class="flex items-center gap-2 mb-2">
									<svg class="w-5 h-5 text-green-600" fill="currentColor" viewBox="0 0 20 20">
										<path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
									</svg>
									<span class="text-sm font-semibold text-green-900">
										Two-factor authentication is enabled
									</span>
								</div>
								<p class="text-sm text-green-800">
									Your account is protected with 2FA. You'll need to enter a code from your authenticator app when signing in.
								</p>
							</div>
							<div class="space-y-3">
								<!-- Backup Codes -->
								<div class="flex items-center justify-between p-3 bg-gray-50 rounded-lg">
									<div>
										<p class="font-medium text-foreground text-sm">Backup Codes</p>
										<p class="text-xs text-muted-foreground">
											{ fmt.Sprintf("%d codes remaining", data.BackupCodesCount) }
										</p>
									</div>
									<form method="POST" action="/mfa/regenerate-backup-codes" class="inline">
										<button
											type="submit"
											class="px-4 py-2 text-sm font-medium text-purple-700 bg-purple-100 hover:bg-purple-200 rounded-md transition-colors"
										>
											Regenerate
										</button>
									</form>
								</div>
								<!-- Disable MFA -->
								<form method="POST" action="/mfa/disable" onsubmit="return confirm('Are you sure you want to disable two-factor authentication? This will make your account less secure.')">
									<button
										type="submit"
										class="w-full px-4 py-2 text-sm font-medium text-red-700 bg-red-50 hover:bg-red-100 rounded-lg transition-colors border border-red-200"
									>
										Disable Two-Factor Authentication
									</button>
								</form>
							</div>
						} else {
							<!-- MFA Disabled State -->
							<div class="bg-amber-50 border border-amber-200 rounded-lg p-4 mb-4">
								<div class="flex items-center gap-2 mb-2">
									<svg class="w-5 h-5 text-amber-600" fill="currentColor" viewBox="0 0 20 20">
										<path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd"></path>
									</svg>
									<span class="text-sm font-semibold text-amber-900">
										Two-factor authentication is not enabled
									</span>
								</div>
								<p class="text-sm text-amber-800">
									Protect your account from unauthorized access by enabling 2FA.
								</p>
							</div>
							<a
								href="/mfa/setup"
								class="inline-flex items-center px-6 py-3 bg-gradient-to-r from-purple-600 to-green-600 text-white font-semibold rounded-lg shadow-md hover:from-purple-700 hover:to-green-700 focus:outline-none focus:ring-2 focus:ring-purple-500 focus:ring-offset-2 transition-all"
							>
								<svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
								</svg>
								Enable Two-Factor Authentication
							</a>
						}
					</div>
				</div>
			</div>
			<!-- Trusted Devices Section (only show if MFA enabled) -->
			if data.MFAEnabled && len(data.TrustedDevices) > 0 {
				<div class="glass-card rounded-xl p-6 mb-6 animate-fade-in-up delay-100">
					<div class="flex items-start gap-4 mb-6">
						<div class="flex-shrink-0">
							<div class="w-12 h-12 bg-gradient-to-r from-green-100 to-emerald-100 rounded-lg flex items-center justify-center">
								<svg class="w-6 h-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"></path>
								</svg>
							</div>
						</div>
						<div class="flex-1">
							<h2 class="text-xl font-semibold text-foreground mb-2">
								Trusted Devices
							</h2>
							<p class="text-sm text-muted-foreground mb-4">
								Devices you've marked as trusted won't require 2FA for 30 days.
							</p>
							<div class="space-y-3">
								for _, device := range data.TrustedDevices {
									<div class="flex items-center justify-between p-4 bg-gray-50 rounded-lg border border-gray-200">
										<div class="flex items-center gap-3">
											<svg class="w-5 h-5 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
												<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"></path>
											</svg>
											<div>
												<p class="text-sm font-medium text-foreground">{ device.DeviceName }</p>
												<p class="text-xs text-muted-foreground">Last used: { device.LastUsedAt }</p>
												<p class="text-xs text-muted-foreground">Added: { device.CreatedAt }</p>
											</div>
										</div>
										<form method="POST" action={ templ.SafeURL("/mfa/remove-trusted-device/" + device.ID) } class="inline">
											<button
												type="submit"
												onclick="return confirm('Remove this trusted device?')"
												class="px-3 py-1.5 text-xs font-medium text-red-700 bg-red-50 hover:bg-red-100 rounded-md transition-colors border border-red-200"
											>
												Remove
											</button>
										</form>
									</div>
								}
								if len(data.TrustedDevices) > 1 {
									<form method="POST" action="/mfa/remove-all-trusted-devices" onsubmit="return confirm('Remove all trusted devices? You will need to verify with 2FA on all devices next time you log in.')">
										<button
											type="submit"
											class="w-full px-4 py-2 text-sm font-medium text-red-700 bg-red-50 hover:bg-red-100 rounded-lg transition-colors border border-red-200"
										>
											Remove All Trusted Devices
										</button>
									</form>
								}
							</div>
						</div>
					</div>
				</div>
			}
			<!-- Password Section -->
			<div class="glass-card rounded-xl p-6 mb-6 animate-fade-in-up delay-200">
				<div class="flex items-start gap-4">
					<div class="flex-shrink-0">
						<div class="w-12 h-12 bg-gradient-to-r from-blue-100 to-purple-100 rounded-lg flex items-center justify-center">
							<svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"></path>
							</svg>
						</div>
					</div>
					<div class="flex-1">
						<h2 class="text-xl font-semibold text-foreground mb-2">
							Password
						</h2>
						<p class="text-sm text-muted-foreground mb-4">
							Update your password regularly to keep your account secure.
						</p>
						<a
							href="/settings/change-password"
							class="inline-flex items-center px-4 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-md hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-purple-500 focus:ring-offset-2"
						>
							Change Password
						</a>
					</div>
				</div>
			</div>
			<!-- Active Sessions Section -->
			<div class="glass-card rounded-xl p-6 mb-6 animate-fade-in-up delay-200">
				<div class="flex items-start gap-4">
					<div class="flex-shrink-0">
						<div class="w-12 h-12 bg-gradient-to-r from-green-100 to-emerald-100 rounded-lg flex items-center justify-center">
							<svg class="w-6 h-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
							</svg>
						</div>
					</div>
					<div class="flex-1">
						<h2 class="text-xl font-semibold text-foreground mb-2">
							Active Sessions
						</h2>
						<p class="text-sm text-muted-foreground mb-4">
							Manage devices that are currently signed in to your account.
						</p>
						<div class="space-y-3">
							<!-- Current Session -->
							<div class="flex items-center justify-between p-3 bg-gray-50 rounded-lg border border-gray-200">
								<div class="flex items-center gap-3">
									<svg class="w-5 h-5 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
									</svg>
									<div>
										<p class="text-sm font-medium text-foreground">Current Device</p>
										<p class="text-xs text-muted-foreground">Active now</p>
									</div>
								</div>
								<span class="text-xs font-medium text-green-600 bg-green-50 px-2 py-1 rounded">
									Active
								</span>
							</div>
							<button
								class="w-full px-4 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-md hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-purple-500 focus:ring-offset-2"
							>
								Sign Out All Other Sessions
							</button>
						</div>
					</div>
				</div>
			</div>
			<!-- Back Button -->
			<div class="mt-6">
				<a
					href="/settings"
					class="inline-flex items-center text-sm text-muted-foreground hover:text-foreground transition-colors"
				>
					<svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
					</svg>
					Back to Settings
				</a>
			</div>
		</div>
	</div>
}
