package settings

import "github.com/FACorreiaa/talentsynapse/internal/app/views/components"

// AccountTab renders the account settings tab content
templ AccountTab(data SettingsData) {
	@components.Tabs(GetSettingsTabs("account"), "settings-tabs")
	<div id="tab-content" role="tabpanel" class="mt-6 animate-fade-in">
		<div class="glass-card rounded-xl p-6">
			<h2 class="text-xl font-semibold text-foreground mb-6 flex items-center gap-2">
				@accountTabIcon()
				Account Settings
			</h2>
			<div class="space-y-4">
				<!-- Email -->
				<div class="flex items-center justify-between py-3 border-b border-border">
					<div>
						<p class="font-medium text-foreground">Email Address</p>
						<p class="text-sm text-muted-foreground">{ data.UserEmail }</p>
					</div>
					<button class="btn btn-sm btn-outline">Change</button>
				</div>
				<!-- Password -->
				<div class="flex items-center justify-between py-3 border-b border-border">
					<div>
						<p class="font-medium text-foreground">Password</p>
						<p class="text-sm text-muted-foreground">Last changed 30 days ago</p>
					</div>
					<button class="btn btn-sm btn-outline">Update</button>
				</div>
				<!-- Username -->
				<div class="flex items-center justify-between py-3">
					<div>
						<p class="font-medium text-foreground">Username</p>
						<p class="text-sm text-muted-foreground">{ "@" + data.UserName }</p>
					</div>
					<button class="btn btn-sm btn-outline">Edit</button>
				</div>
			</div>
		</div>
	</div>
}

// NotificationsTab renders the notifications settings tab content
templ NotificationsTab(data SettingsData) {
	@components.Tabs(GetSettingsTabs("notifications"), "settings-tabs")
	<div id="tab-content" role="tabpanel" class="mt-6 animate-fade-in">
		<div class="glass-card rounded-xl p-6">
			<h2 class="text-xl font-semibold text-foreground mb-6 flex items-center gap-2">
				@bellTabIcon()
				Notification Preferences
			</h2>
			<div class="space-y-4">
				@toggleSetting("Email Notifications", "Receive email updates about matches and messages", true)
				@toggleSetting("Push Notifications", "Get notified on your device", true)
				@toggleSetting("Match Alerts", "Be notified when new skill matches are found", true)
				@toggleSetting("Session Reminders", "Get reminders before scheduled sessions", true)
				@toggleSetting("Marketing Emails", "News, tips, and product updates", false)
			</div>
		</div>
	</div>
}

// PrivacyTab renders the privacy settings tab content
templ PrivacyTab(data SettingsData) {
	@components.Tabs(GetSettingsTabs("privacy"), "settings-tabs")
	<div id="tab-content" role="tabpanel" class="mt-6 animate-fade-in">
		<div class="glass-card rounded-xl p-6">
			<h2 class="text-xl font-semibold text-foreground mb-6 flex items-center gap-2">
				@privacyTabIcon()
				Privacy Settings
			</h2>
			<div class="space-y-4">
				@toggleSetting("Profile Visibility", "Allow others to find your profile", true)
				@toggleSetting("Show Online Status", "Let others see when you're online", true)
				@toggleSetting("Show Skills Publicly", "Display your skills on your public profile", true)
				@toggleSetting("Allow Messages from Anyone", "Let non-connections send you messages", false)
				@toggleSetting("Show Activity Status", "Display your recent activity", true)
			</div>
		</div>
	</div>
}

// SecurityTabContent renders the security settings tab content (partial, for HTMX)
templ SecurityTabContent(data SettingsData, mfaEnabled bool) {
	@components.Tabs(GetSettingsTabs("security"), "settings-tabs")
	<div id="tab-content" role="tabpanel" class="mt-6 animate-fade-in">
		<div class="glass-card rounded-xl p-6">
			<h2 class="text-xl font-semibold text-foreground mb-6 flex items-center gap-2">
				@securityTabIcon()
				Security Settings
			</h2>
			<div class="space-y-6">
				<!-- Two-Factor Authentication -->
				<div class="flex items-center justify-between py-3 border-b border-border">
					<div>
						<p class="font-medium text-foreground">Two-Factor Authentication</p>
						<p class="text-sm text-muted-foreground">
							if mfaEnabled {
								Enabled - Your account is protected with 2FA
							} else {
								Add an extra layer of security to your account
							}
						</p>
					</div>
					if mfaEnabled {
						<span class="badge badge-success">Enabled</span>
					} else {
						<a href="/settings/security" class="btn btn-sm btn-primary">Enable</a>
					}
				</div>
				<!-- Active Sessions -->
				<div class="flex items-center justify-between py-3 border-b border-border">
					<div>
						<p class="font-medium text-foreground">Active Sessions</p>
						<p class="text-sm text-muted-foreground">Manage your active login sessions</p>
					</div>
					<button class="btn btn-sm btn-outline">View Sessions</button>
				</div>
				<!-- Login History -->
				<div class="flex items-center justify-between py-3">
					<div>
						<p class="font-medium text-foreground">Login History</p>
						<p class="text-sm text-muted-foreground">View your recent login activity</p>
					</div>
					<button class="btn btn-sm btn-outline">View History</button>
				</div>
			</div>
		</div>
	</div>
}

// AppearanceTab renders the appearance settings tab content
templ AppearanceTab(data SettingsData) {
	@components.Tabs(GetSettingsTabs("appearance"), "settings-tabs")
	<div id="tab-content" role="tabpanel" class="mt-6 animate-fade-in">
		<div class="glass-card rounded-xl p-6">
			<h2 class="text-xl font-semibold text-foreground mb-6 flex items-center gap-2">
				@paletteTabIcon()
				Appearance
			</h2>
			<div class="space-y-6">
				<!-- Theme -->
				<div class="flex items-center justify-between py-3 border-b border-border">
					<div>
						<p class="font-medium text-foreground">Theme</p>
						<p class="text-sm text-muted-foreground">Choose your preferred color scheme</p>
					</div>
					<div class="flex gap-2">
						<button class="btn btn-sm btn-outline" id="theme-light">Light</button>
						<button class="btn btn-sm btn-primary" id="theme-dark">Dark</button>
						<button class="btn btn-sm btn-outline" id="theme-system">System</button>
					</div>
				</div>
				<!-- Font Size -->
				<div class="flex items-center justify-between py-3 border-b border-border">
					<div>
						<p class="font-medium text-foreground">Font Size</p>
						<p class="text-sm text-muted-foreground">Adjust the text size</p>
					</div>
					<select class="select select-bordered select-sm">
						<option>Small</option>
						<option selected>Medium</option>
						<option>Large</option>
					</select>
				</div>
				<!-- Reduce Motion -->
				<div class="flex items-center justify-between py-3">
					<div>
						<p class="font-medium text-foreground">Reduce Motion</p>
						<p class="text-sm text-muted-foreground">Minimize animations throughout the app</p>
					</div>
					<label class="relative inline-flex items-center cursor-pointer">
						<input type="checkbox" class="sr-only peer"/>
						<div class="w-11 h-6 bg-muted rounded-full peer peer-checked:bg-primary peer-focus:ring-2 peer-focus:ring-primary/50 after:content-[''] after:absolute after:top-0.5 after:left-[2px] after:bg-white after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:after:translate-x-full"></div>
					</label>
				</div>
			</div>
		</div>
	</div>
}

// DangerTab renders the danger zone settings tab content
templ DangerTab(data SettingsData) {
	@components.Tabs(GetSettingsTabs("danger"), "settings-tabs")
	<div id="tab-content" role="tabpanel" class="mt-6 animate-fade-in">
		<div class="glass-card rounded-xl p-6 border border-destructive/20">
			<h2 class="text-xl font-semibold text-destructive mb-6 flex items-center gap-2">
				@dangerTabIcon()
				Danger Zone
			</h2>
			<div class="space-y-6">
				<!-- Export Data -->
				<div class="flex items-center justify-between py-3 border-b border-border">
					<div>
						<p class="font-medium text-foreground">Export Your Data</p>
						<p class="text-sm text-muted-foreground">Download a copy of all your data</p>
					</div>
					<button class="btn btn-sm btn-outline">Export</button>
				</div>
				<!-- Deactivate Account -->
				<div class="flex items-center justify-between py-3 border-b border-border">
					<div>
						<p class="font-medium text-foreground">Deactivate Account</p>
						<p class="text-sm text-muted-foreground">Temporarily disable your account</p>
					</div>
					<button class="btn btn-sm btn-outline border-warning text-warning hover:bg-warning hover:text-warning-foreground">
						Deactivate
					</button>
				</div>
				<!-- Delete Account -->
				<div class="flex items-center justify-between py-3">
					<div>
						<p class="font-medium text-foreground">Delete Account</p>
						<p class="text-sm text-muted-foreground">Permanently delete your account and all data. This action cannot be undone.</p>
					</div>
					<button
						class="btn btn-sm btn-outline border-destructive text-destructive hover:bg-destructive hover:text-destructive-foreground"
						hx-delete="/settings/account"
						hx-confirm="Are you absolutely sure you want to delete your account? This cannot be undone."
					>
						Delete Account
					</button>
				</div>
			</div>
		</div>
	</div>
}

// Icon components for tabs
templ accountTabIcon() {
	<svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
		<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
	</svg>
}

templ bellTabIcon() {
	<svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
		<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"></path>
	</svg>
}

templ privacyTabIcon() {
	<svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
		<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
	</svg>
}

templ securityTabIcon() {
	<svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
		<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
	</svg>
}

templ paletteTabIcon() {
	<svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
		<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01"></path>
	</svg>
}

templ dangerTabIcon() {
	<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
		<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
	</svg>
}

// toggleSetting renders a toggle switch setting row
templ toggleSetting(title string, description string, enabled bool) {
	<div class="flex items-center justify-between py-3 border-b border-border last:border-0">
		<div class="flex-1 pr-4">
			<p class="font-medium text-foreground">{ title }</p>
			<p class="text-sm text-muted-foreground">{ description }</p>
		</div>
		<label class="relative inline-flex items-center cursor-pointer flex-shrink-0">
			<input
				type="checkbox"
				class="sr-only peer"
				if enabled {
					checked
				}
			/>
			<div class="w-11 h-6 bg-muted rounded-full peer peer-checked:bg-primary peer-focus:ring-2 peer-focus:ring-primary/50 after:content-[''] after:absolute after:top-0.5 after:left-[2px] after:bg-white after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:after:translate-x-full"></div>
		</label>
	</div>
}
