package calendar

import (
	"fmt"
	"time"

	"github.com/google/uuid"

	"github.com/FACorreiaa/talentsynapse/internal/app/types"
	"github.com/FACorreiaa/talentsynapse/internal/app/views/components"
	"github.com/FACorreiaa/talentsynapse/internal/app/views/layouts"
)

templ CalendarPage(sessionData types.SessionData, calendarMonth *CalendarMonth, upcomingSessions []SessionView) {
	@layouts.Base("Calendar | TalentSynapse") {
		@components.Navbar(true, sessionData.UserName, sessionData.UserAvatar)
		<div class="container mx-auto px-4 py-8">
			<div class="flex justify-between items-center mb-6">
				<h1 class="text-3xl font-bold">My Calendar</h1>
				<a href="/discover" class="btn btn-primary">
					Schedule New Session
				</a>
			</div>
			<!-- WebSocket connection for live updates -->
			<div hx-ext="ws" ws-connect="/calendar/ws" id="calendar-ws"></div>
			<!-- Notification container for in-app reminders -->
			<div id="notifications" class="fixed top-20 right-4 z-50 space-y-2"></div>
			<div class="grid grid-cols-1 lg:grid-cols-4 gap-6">
				<!-- Calendar Grid -->
				<div class="lg:col-span-3">
					@CalendarNavigation(calendarMonth.Year, int(calendarMonth.Month))
					<div id="calendar-container" class="mt-4">
						@CalendarGrid(calendarMonth)
					</div>
				</div>
				<!-- Upcoming Sessions Sidebar -->
				<div class="lg:col-span-1">
					<div class="card bg-base-200 shadow-xl">
						<div class="card-body">
							<h2 class="card-title">Upcoming Sessions</h2>
							if len(upcomingSessions) == 0 {
								<p class="text-sm text-gray-500">No upcoming sessions</p>
							} else {
								<div class="space-y-2">
									for _, session := range upcomingSessions {
										@UpcomingSessionCard(session)
									}
								</div>
							}
						</div>
					</div>
				</div>
			</div>
		</div>
		<!-- Modal for session details -->
		<dialog id="session-modal" class="modal">
			<div class="modal-box w-11/12 max-w-2xl" id="modal-content">
				<!-- Content loaded via HTMX -->
			</div>
			<form method="dialog" class="modal-backdrop">
				<button>close</button>
			</form>
		</dialog>
	}
}

templ CalendarNavigation(year int, month int) {
	<div class="flex justify-between items-center mb-4">
		<button
			class="btn btn-ghost"
			hx-get={ fmt.Sprintf("/calendar/month?year=%d&month=%d", prevYear(year, month), prevMonth(month)) }
			hx-target="#calendar-container"
			hx-swap="innerHTML"
		>
			← Previous
		</button>
		<h2 class="text-xl font-semibold">
			{ time.Month(month).String() } { fmt.Sprintf("%d", year) }
		</h2>
		<button
			class="btn btn-ghost"
			hx-get={ fmt.Sprintf("/calendar/month?year=%d&month=%d", nextYear(year, month), nextMonth(month)) }
			hx-target="#calendar-container"
			hx-swap="innerHTML"
		>
			Next →
		</button>
	</div>
}

templ CalendarGrid(cal *CalendarMonth) {
	<div class="bg-base-100 rounded-lg shadow-lg p-4">
		<!-- Day headers -->
		<div class="grid grid-cols-7 gap-2 mb-2">
			for _, day := range cal.WeekDays {
				<div class="text-center font-bold p-2 text-sm">{ day }</div>
			}
		</div>
		<!-- Calendar days -->
		<div class="grid grid-cols-7 gap-2">
			for _, day := range cal.Days {
				@DayCell(day)
			}
		</div>
	</div>
}

templ DayCell(day CalendarDay) {
	<div
		class={ "border rounded-lg p-2 min-h-[100px] hover:bg-base-200 transition cursor-pointer",
				templ.KV("ring-2 ring-primary", day.IsToday) }
	>
		<div class="text-sm font-semibold mb-1">{ fmt.Sprintf("%d", day.Day) }</div>
		<div class="space-y-1">
			if len(day.Sessions) > 0 {
				for _, session := range day.Sessions {
					<div
						class={ "text-xs p-1 rounded cursor-pointer", sessionStatusClass(session.Status) }
						hx-get={ "/calendar/session/" + session.ID.String() }
						hx-target="#modal-content"
						hx-swap="innerHTML"
						onclick="document.getElementById('session-modal').showModal()"
					>
						<div class="font-semibold truncate">
							{ session.ScheduledStart.Format("3:04 PM") }
						</div>
						<div class="truncate text-[10px]">
							{ session.PartnerName }
						</div>
					</div>
				}
			}
		</div>
	</div>
}

templ UpcomingSessionCard(session SessionView) {
	<div
		class="card bg-base-100 shadow-sm cursor-pointer hover:shadow-md transition"
		hx-get={ "/calendar/session/" + session.ID.String() }
		hx-target="#modal-content"
		hx-swap="innerHTML"
		onclick="document.getElementById('session-modal').showModal()"
	>
		<div class="card-body p-3">
			<div class="flex items-center gap-2">
				<div class="avatar placeholder">
					<div class="bg-neutral text-neutral-content rounded-full w-8">
						if session.PartnerAvatar != "" {
							<img src={ session.PartnerAvatar } alt={ session.PartnerName }/>
						} else {
							<span class="text-xs">{ string(session.PartnerName[0]) }</span>
						}
					</div>
				</div>
				<div class="flex-1 min-w-0">
					<p class="text-sm font-semibold truncate">{ session.PartnerName }</p>
					<p class="text-xs text-gray-500">
						{ session.ScheduledStart.Format("Jan 2, 3:04 PM") }
					</p>
				</div>
			</div>
			<div class={ "badge badge-sm", sessionStatusBadge(session.Status) }>
				{ session.Status }
			</div>
		</div>
	</div>
}

templ SessionForm(sessionData types.SessionData, partnerID string) {
	<div class="p-4">
		<h3 class="text-xl font-bold mb-4">Schedule Skill Exchange</h3>
		<form
			hx-post="/calendar/session/create"
			hx-target="#modal-content"
			hx-swap="innerHTML"
		>
			<input type="hidden" name="partner_id" value={ partnerID }/>
			<!-- Date/Time Picker -->
			<div class="form-control mb-4">
				<label class="label">
					<span class="label-text">Start Time</span>
				</label>
				<input
					type="datetime-local"
					name="start_time"
					class="input input-bordered"
					required
				/>
			</div>
			<div class="form-control mb-4">
				<label class="label">
					<span class="label-text">End Time</span>
				</label>
				<input
					type="datetime-local"
					name="end_time"
					class="input input-bordered"
					required
				/>
			</div>
			<!-- Location -->
			<div class="form-control mb-4">
				<label class="label">
					<span class="label-text">Location Type</span>
				</label>
				<select name="location_type" class="select select-bordered">
					<option value="virtual">Virtual (Video Call)</option>
					<option value="in_person">In Person</option>
					<option value="hybrid">Hybrid</option>
				</select>
			</div>
			<div class="form-control mb-4">
				<label class="label">
					<span class="label-text">Meeting Link / Location</span>
				</label>
				<input
					type="text"
					name="location_details"
					class="input input-bordered"
					placeholder="Zoom link or address"
				/>
			</div>
			<!-- Notes -->
			<div class="form-control mb-4">
				<label class="label">
					<span class="label-text">Notes</span>
				</label>
				<textarea
					name="notes"
					class="textarea textarea-bordered"
					rows="3"
				></textarea>
			</div>
			<div class="modal-action">
				<button
					type="button"
					class="btn"
					onclick="document.getElementById('session-modal').close()"
				>
					Cancel
				</button>
				<button type="submit" class="btn btn-primary">
					Send Request
				</button>
			</div>
		</form>
	</div>
}

templ SessionDetails(session *SessionView, sessionData types.SessionData) {
	<div class="p-4">
		<h3 class="text-xl font-bold mb-4">Session Details</h3>
		<div class="space-y-4">
			<!-- Partner Info -->
			<div class="flex items-center gap-3">
				<div class="avatar placeholder">
					<div class="bg-neutral text-neutral-content rounded-full w-16">
						if session.PartnerAvatar != "" {
							<img src={ session.PartnerAvatar } alt={ session.PartnerName }/>
						} else {
							<span class="text-2xl">{ string(session.PartnerName[0]) }</span>
						}
					</div>
				</div>
				<div>
					<p class="font-semibold text-lg">{ session.PartnerName }</p>
					<div class={ "badge", sessionStatusBadge(session.Status) }>
						{ session.Status }
					</div>
				</div>
			</div>
			<!-- Time -->
			<div>
				<p class="text-sm text-gray-500">Time</p>
				<p class="font-semibold">
					{ session.ScheduledStart.Format("Monday, January 2, 2006") }
				</p>
				<p class="text-sm">
					{ session.ScheduledStart.Format("3:04 PM") } - { session.ScheduledEnd.Format("3:04 PM") }
				</p>
			</div>
			<!-- Location -->
			<div>
				<p class="text-sm text-gray-500">Location</p>
				<p class="font-semibold capitalize">{ session.LocationType }</p>
				if session.LocationDetails != "" {
					<p class="text-sm">{ session.LocationDetails }</p>
				}
			</div>
			<!-- Notes -->
			if session.Notes != "" {
				<div>
					<p class="text-sm text-gray-500">Notes</p>
					<p class="text-sm">{ session.Notes }</p>
				</div>
			}
			<!-- Actions -->
			<div class="modal-action">
				if session.Status == "pending" && !session.IsInitiator {
					<button
						class="btn btn-success"
						hx-post={ "/calendar/session/" + session.ID.String() + "/confirm" }
						hx-target="#modal-content"
						hx-swap="innerHTML"
					>
						Confirm Session
					</button>
				}
				if session.Status != "completed" && session.Status != "cancelled" {
					<button
						class="btn btn-error"
						hx-post={ "/calendar/session/" + session.ID.String() + "/cancel" }
						hx-target="#modal-content"
						hx-swap="innerHTML"
						hx-confirm="Are you sure you want to cancel this session?"
					>
						Cancel Session
					</button>
				}
				<button
					class="btn"
					onclick="document.getElementById('session-modal').close()"
				>
					Close
				</button>
			</div>
		</div>
	</div>
}

templ SessionCreatedSuccess(sessionID uuid.UUID) {
	<div class="p-4">
		<div class="alert alert-success mb-4">
			<svg xmlns="http://www.w3.org/2000/svg" class="stroke-current shrink-0 h-6 w-6" fill="none" viewBox="0 0 24 24">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
			</svg>
			<span>Session request sent successfully!</span>
		</div>
		<p class="text-sm text-gray-600 mb-4">
			Your partner will be notified and can confirm the session.
		</p>
		<button
			class="btn btn-primary"
			onclick="document.getElementById('session-modal').close(); window.location.reload()"
		>
			Close
		</button>
	</div>
}
