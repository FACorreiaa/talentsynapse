package chat

import (
	"fmt"
	"github.com/FACorreiaa/talentsynapse/internal/app/views/layouts"
	"time"
)

// MessageItem represents a message for display
type MessageItem struct {
	ID              string
	SenderID        string
	SenderName      string
	SenderAvatar    string
	Content         string
	SentAt          time.Time
	IsOwn           bool
	Type            string // text, image, file, voice, system
	FileURL         string
	FileName        string
	FileSize        int64
	FileMimeType    string
	DurationSeconds int
}

// ChatRoomData holds the data needed for the chat room view
type ChatRoomData struct {
	ConversationID string
	PartnerID      string
	PartnerName    string
	PartnerAvatar  string
	Messages       []MessageItem
}

templ ChatRoom(data ChatRoomData, userName string, userAvatar string, currentUserID string) {
	@layouts.AppLayout(data.PartnerName+" | TalentSynapse", true, userName, userAvatar) {
		@ChatRoomContent(data, currentUserID)
	}
}

// ChatRoomContent renders just the main content (for HTMX partial swaps)
templ ChatRoomContent(data ChatRoomData, currentUserID string) {
	<div class="flex flex-col h-[calc(100vh-8rem)]">
		<!-- Chat Header -->
		<div class="glass-card border-b border-border px-4 py-3 flex items-center gap-4 sticky top-0 z-10">
			<a href="/chat" class="btn btn-ghost p-2">
				<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
				</svg>
			</a>
			<div class="flex items-center gap-3 flex-1">
				if data.PartnerAvatar != "" {
					<img
						src={ data.PartnerAvatar }
						alt={ data.PartnerName }
						class="w-10 h-10 rounded-full object-cover"
					/>
				} else {
					<div class="w-10 h-10 rounded-full bg-gradient-to-br from-primary to-accent flex items-center justify-center text-primary-foreground font-bold">
						{ getInitial(data.PartnerName) }
					</div>
				}
				<div>
					<h2 class="font-semibold text-foreground">{ data.PartnerName }</h2>
					<p class="text-xs text-emerald-500">Online</p>
				</div>
			</div>
			<a href={ templ.SafeURL("/users/" + data.PartnerID) } class="btn btn-ghost p-2" title="View Profile">
				<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
				</svg>
			</a>
		</div>
		<!-- Messages Container -->
		<div
			id="messages-container"
			class="flex-1 overflow-y-auto p-4 space-y-4"
			hx-ext="ws"
			ws-connect={ "/chat/ws?conversation=" + data.ConversationID }
		>
			<div id="messages-list" class="space-y-4">
				if len(data.Messages) == 0 {
					@emptyChat(data.PartnerName)
				} else {
					for _, msg := range data.Messages {
						@MessageBubble(msg)
					}
				}
			</div>
			<!-- Typing Indicator -->
			@TypingIndicator(data.PartnerName, data.PartnerAvatar)
		</div>
		<!-- Message Input -->
		<div class="glass-card border-t border-border p-4 sticky bottom-0">
			<!-- Normal Input Mode -->
			<form
				id="message-form"
				hx-post={ "/chat/" + data.ConversationID + "/messages" }
				hx-target="#messages-list"
				hx-swap="beforeend"
				hx-on::after-request="this.reset(); document.getElementById('messages-container').scrollTop = document.getElementById('messages-container').scrollHeight;"
				class="flex items-center gap-3"
			>
				<input
					type="text"
					id="message-input"
					name="message"
					placeholder="Type a message..."
					class="input flex-1"
					autocomplete="off"
					required
				/>
				<!-- Voice Record Button -->
				<button
					type="button"
					id="voice-record-btn"
					onclick="startVoiceRecording()"
					class="btn btn-ghost p-3 text-muted-foreground hover:text-primary"
					title="Record voice message"
				>
					<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0 0H8m4 0h4m-4-8a3 3 0 01-3-3V5a3 3 0 116 0v6a3 3 0 01-3 3z"></path>
					</svg>
				</button>
				<button type="submit" class="btn btn-primary btn-glow p-3">
					<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"></path>
					</svg>
				</button>
			</form>
			<!-- Voice Recording Mode (hidden by default) -->
			<div id="voice-recording-ui" class="hidden flex items-center gap-3">
				<div class="flex items-center gap-2 flex-1">
					<span class="recording-dot w-3 h-3 rounded-full bg-red-500 animate-pulse"></span>
					<span id="recording-time" class="text-sm font-medium text-foreground">0:00</span>
					<div class="flex-1 h-8 bg-muted/50 rounded-lg overflow-hidden">
						<div id="recording-waveform" class="h-full flex items-center justify-center gap-0.5 px-2">
							<!-- Waveform bars will be animated via JS -->
							for i := 0; i < 30; i++ {
								<div class="recording-bar w-1 bg-primary rounded-full transition-all" style="height: 4px;"></div>
							}
						</div>
					</div>
				</div>
				<button
					type="button"
					onclick="cancelVoiceRecording()"
					class="btn btn-ghost p-3 text-red-500 hover:bg-red-500/10"
					title="Cancel"
				>
					<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
					</svg>
				</button>
				<button
					type="button"
					onclick="stopVoiceRecording()"
					class="btn btn-primary btn-glow p-3"
					title="Send voice message"
				>
					<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"></path>
					</svg>
				</button>
			</div>
		</div>
	</div>
	<!-- Auto-scroll to bottom on load -->
	<script>
		document.addEventListener('DOMContentLoaded', function() {
			const container = document.getElementById('messages-container');
			if (container) {
				container.scrollTop = container.scrollHeight;
			}
		});
	</script>
}

templ MessageBubble(msg MessageItem) {
	<div class={ "flex items-end gap-2", templ.KV("flex-row-reverse", msg.IsOwn) } id={ "msg-" + msg.ID }>
		if !msg.IsOwn {
			if msg.SenderAvatar != "" {
				<img
					src={ msg.SenderAvatar }
					alt={ msg.SenderName }
					class="w-8 h-8 rounded-full object-cover flex-shrink-0"
				/>
			} else {
				<div class="w-8 h-8 rounded-full bg-muted flex items-center justify-center text-muted-foreground text-sm font-bold flex-shrink-0">
					{ getInitial(msg.SenderName) }
				</div>
			}
		}
		<div class={ "max-w-[70%] rounded-2xl px-4 py-2", templ.KV("bg-primary text-primary-foreground rounded-br-md", msg.IsOwn), templ.KV("bg-muted text-foreground rounded-bl-md", !msg.IsOwn) }>
			if msg.Type == "voice" {
				@VoiceMessageContent(msg)
			} else {
				<p class="text-sm whitespace-pre-wrap break-words">{ msg.Content }</p>
			}
			<p class={ "text-xs mt-1 opacity-70", templ.KV("text-right", msg.IsOwn) }>
				{ msg.SentAt.Format("3:04 PM") }
			</p>
		</div>
	</div>
}

// VoiceMessageContent renders the audio player for voice messages
templ VoiceMessageContent(msg MessageItem) {
	<div class="voice-message-player flex items-center gap-3 min-w-[200px]">
		<button
			type="button"
			class="voice-play-btn w-10 h-10 rounded-full bg-white/20 hover:bg-white/30 flex items-center justify-center transition-colors flex-shrink-0"
			onclick={ templ.ComponentScript{Call: "toggleVoicePlayback(this)"} }
			data-audio-url={ msg.FileURL }
		>
			<svg class="play-icon w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
				<path d="M8 5v14l11-7z"></path>
			</svg>
			<svg class="pause-icon w-5 h-5 hidden" fill="currentColor" viewBox="0 0 24 24">
				<path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"></path>
			</svg>
		</button>
		<div class="flex-1 min-w-0">
			<div class="voice-waveform h-8 flex items-center gap-0.5">
				<!-- Waveform visualization bars -->
				for i := 0; i < 20; i++ {
					<div class={ "waveform-bar w-1 bg-current opacity-40 rounded-full transition-all", getWaveformHeight(i) }></div>
				}
			</div>
			<div class="flex justify-between items-center mt-1">
				<span class="voice-current-time text-xs opacity-70">0:00</span>
				<span class="voice-duration text-xs opacity-70">{ formatDuration(msg.DurationSeconds) }</span>
			</div>
		</div>
	</div>
}

templ TypingIndicator(partnerName string, partnerAvatar string) {
	<div id="typing-indicator" class="flex items-end gap-2" style="display: none;">
		if partnerAvatar != "" {
			<img
				src={ partnerAvatar }
				alt={ partnerName }
				class="w-8 h-8 rounded-full object-cover flex-shrink-0"
			/>
		} else {
			<div class="w-8 h-8 rounded-full bg-muted flex items-center justify-center text-muted-foreground text-sm font-bold flex-shrink-0">
				{ getInitial(partnerName) }
			</div>
		}
		<div class="bg-muted text-foreground rounded-2xl rounded-bl-md px-4 py-3">
			<div class="flex items-center gap-1">
				<div class="typing-dot"></div>
				<div class="typing-dot" style="animation-delay: 0.2s;"></div>
				<div class="typing-dot" style="animation-delay: 0.4s;"></div>
			</div>
		</div>
	</div>
}

templ emptyChat(partnerName string) {
	<div class="flex flex-col items-center justify-center h-full py-12 text-center">
		<div class="w-16 h-16 rounded-full bg-primary/10 flex items-center justify-center mb-4">
			<svg class="w-8 h-8 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path>
			</svg>
		</div>
		<h3 class="text-lg font-semibold text-foreground mb-2">Start the Conversation</h3>
		<p class="text-sm text-muted-foreground max-w-xs">
			Say hello to { partnerName } and start exchanging skills!
		</p>
	</div>
}

// formatDuration converts seconds to MM:SS format
func formatDuration(seconds int) string {
	if seconds <= 0 {
		return "0:00"
	}
	mins := seconds / 60
	secs := seconds % 60
	return fmt.Sprintf("%d:%02d", mins, secs)
}

// getWaveformHeight returns a random-ish height class for waveform visualization
func getWaveformHeight(index int) string {
	heights := []string{"h-2", "h-4", "h-6", "h-3", "h-5", "h-4", "h-7", "h-3", "h-5", "h-6",
		"h-4", "h-3", "h-5", "h-7", "h-4", "h-6", "h-3", "h-5", "h-4", "h-3"}
	if index < len(heights) {
		return heights[index]
	}
	return "h-4"
}
