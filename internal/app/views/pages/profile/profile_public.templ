package profile

import (
	"fmt"
	"github.com/FACorreiaa/talentsynapse/internal/app/views/components"
	"github.com/FACorreiaa/talentsynapse/internal/app/views/layouts"
	"time"
)

// PublicProfileData holds another user's profile info for display
type PublicProfileData struct {
	ID            string
	Username      string
	DisplayName   string
	AvatarURL     string
	Bio           string
	OfferedSkills []string
	WantedSkills  []string
	IsConnected   bool
	Badges        []BadgeData
	Tier          string // "Bronze", "Silver", "Gold"
	Reviews       []ReviewData
	SocialLinks   SocialLinksData
	Portfolio     []PortfolioItem
}

type ReviewData struct {
	Rating         int
	Comment        string
	ReviewerName   string
	ReviewerAvatar string
	CreatedAt      time.Time
}

type BadgeData struct {
	Name    string
	Icon    string
	Code    string
	Awarded bool
}

templ PublicProfile(p PublicProfileData, userName string, userAvatar string) {
	@layouts.Base(p.DisplayName + " | TalentSynapse") {
		<div class="min-h-screen flex flex-col bg-background">
			@components.Navbar(true, userName, userAvatar)
			<main class="flex-1 py-8 px-4">
				<div class="container mx-auto max-w-3xl">
					<!-- Profile Header -->
					<div class="glass-card rounded-2xl p-8 mb-6 animate-fade-in-up">
						<div class="flex flex-col md:flex-row items-center gap-6">
							<!-- Avatar -->
							<div class="relative">
								if p.AvatarURL != "" {
									<img
										src={ p.AvatarURL }
										alt={ p.DisplayName }
										class="w-32 h-32 rounded-full object-cover ring-4 ring-primary/20"
									/>
								} else {
									<div class="w-32 h-32 rounded-full bg-gradient-to-br from-primary to-accent flex items-center justify-center text-primary-foreground text-4xl font-bold">
										{ getPublicInitial(p.DisplayName) }
									</div>
								}
							</div>
							<!-- Info -->
							<div class="flex-1 text-center md:text-left">
								<h1 class="text-3xl font-bold text-foreground mb-1">{ p.DisplayName }</h1>
								<p class="text-muted-foreground mb-3">{ "@" + p.Username }</p>
								if p.Bio != "" {
									<p class="text-foreground/80 max-w-xl mb-4">{ p.Bio }</p>
								}
								<!-- Social Links -->
								<div class="flex gap-4 mb-2">
									if p.SocialLinks.GitHub != "" {
										<a href={ templ.SafeURL(p.SocialLinks.GitHub) } target="_blank" class="text-muted-foreground hover:text-foreground transition-colors">
											<svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"></path></svg>
										</a>
									}
									if p.SocialLinks.LinkedIn != "" {
										<a href={ templ.SafeURL(p.SocialLinks.LinkedIn) } target="_blank" class="text-muted-foreground hover:text-blue-600 transition-colors">
											<svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"></path></svg>
										</a>
									}
									if p.SocialLinks.Twitter != "" {
										<a href={ templ.SafeURL(p.SocialLinks.Twitter) } target="_blank" class="text-muted-foreground hover:text-sky-500 transition-colors">
											<svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M24 4.557c-.883.392-1.832.656-2.828.775 1.017-.609 1.798-1.574 2.165-2.724-.951.564-2.005.974-3.127 1.195-.897-.957-2.178-1.555-3.594-1.555-3.179 0-5.515 2.966-4.797 6.045-4.091-.205-7.719-2.165-10.148-5.144-1.29 2.213-.669 5.108 1.523 6.574-.806-.026-1.566-.247-2.229-.616-.054 2.281 1.581 4.415 3.949 4.89-.693.188-1.452.232-2.224.084.626 1.956 2.444 3.379 4.6 3.419-2.07 1.623-4.678 2.348-7.29 2.04 2.179 1.397 4.768 2.212 7.548 2.212 9.142 0 14.307-7.721 13.995-14.646.962-.695 1.797-1.562 2.457-2.549z"></path></svg>
										</a>
									}
									if p.SocialLinks.Website != "" {
										<a href={ templ.SafeURL(p.SocialLinks.Website) } target="_blank" class="text-muted-foreground hover:text-purple-600 transition-colors">
											<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"></path></svg>
										</a>
									}
								</div>
								<!-- Tier Badge -->
								if p.Tier != "" {
									<div
										class={ "inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium mt-2",
										templ.KV("bg-amber-100 text-amber-800", p.Tier == "Bronze"),
										templ.KV("bg-gray-100 text-gray-800", p.Tier == "Silver"),
										templ.KV("bg-yellow-100 text-yellow-800", p.Tier == "Gold") }
									>
										{ p.Tier } Member
									</div>
								}
							</div>
							<!-- Action Button -->
							<div class="flex-shrink-0">
								if p.IsConnected {
									<a href={ templ.SafeURL("/chat/start/" + p.ID) } class="btn btn-primary btn-glow">
										<svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
											<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path>
										</svg>
										Message
									</a>
								} else {
									<span class="text-sm text-muted-foreground bg-muted px-4 py-2 rounded-lg">
										Connect via Matches to chat
									</span>
								}
								if p.IsConnected {
									<!-- Review Button (Only if connected) -->
									<button
										class="mt-2 btn btn-outline btn-sm w-full"
										_={ fmt.Sprintf("on click me('#review-modal-%s').showModal()", p.ID) }
									>
										Leave Review
									</button>
								}
								<!-- Report Button -->
								<button
									class="mt-4 block text-xs text-red-500 hover:text-red-700 underline"
									_={ fmt.Sprintf("on click me('#report-modal-%s').showModal()", p.ID) }
								>
									Report User
								</button>
								<!-- Report Modal -->
								<dialog id={ fmt.Sprintf("report-modal-%s", p.ID) } class="modal">
									<div class="modal-box bg-white dark:bg-gray-800">
										<h3 class="font-bold text-lg text-gray-900 dark:text-gray-100">Report { p.DisplayName }</h3>
										<p class="py-4 text-gray-500 dark:text-gray-400">Please describe the issue. This will be reviewed by our moderation team.</p>
										<form action="/report" method="POST">
											<input type="hidden" name="reported_user_id" value={ p.ID }/>
											<input type="hidden" name="content_id" value={ p.ID }/>
											<input type="hidden" name="content_type" value="profile"/>
											<div class="form-control mb-4">
												<label class="label">
													<span class="label-text">Reason</span>
												</label>
												<select name="report_type" class="select select-bordered w-full dark:bg-gray-700 dark:text-white" required>
													<option value="spam">Spam</option>
													<option value="harassment">Harassment</option>
													<option value="inappropriate_content">Inappropriate Content</option>
													<option value="fraud">Fraud</option>
													<option value="other">Other</option>
												</select>
											</div>
											<div class="form-control mb-4">
												<label class="label">
													<span class="label-text">Description</span>
												</label>
												<textarea name="description" class="textarea textarea-bordered h-24 dark:bg-gray-700 dark:text-white" placeholder="Provide more details..." required></textarea>
											</div>
											<div class="modal-action">
												<button
													type="button"
													class="btn btn-ghost"
													_={ fmt.Sprintf("on click me('#report-modal-%s').close()", p.ID) }
												>
													Cancel
												</button>
												<button type="submit" class="btn btn-error">Submit Report</button>
											</div>
										</form>
									</div>
									<form method="dialog" class="modal-backdrop">
										<button>close</button>
									</form>
								</dialog>
								<!-- Review Modal -->
								<dialog id={ fmt.Sprintf("review-modal-%s", p.ID) } class="modal">
									<div class="modal-box bg-white dark:bg-gray-800">
										<h3 class="font-bold text-lg text-gray-900 dark:text-gray-100">Review { p.DisplayName }</h3>
										<form action="/review" method="POST">
											<input type="hidden" name="target_user_id" value={ p.ID }/>
											<div class="form-control mb-4">
												<label class="label">
													<span class="label-text">Rating</span>
												</label>
												<div class="rating rating-lg">
													<input type="radio" name="rating" value="1" class="mask mask-star-2 bg-orange-400"/>
													<input type="radio" name="rating" value="2" class="mask mask-star-2 bg-orange-400"/>
													<input type="radio" name="rating" value="3" class="mask mask-star-2 bg-orange-400"/>
													<input type="radio" name="rating" value="4" class="mask mask-star-2 bg-orange-400"/>
													<input type="radio" name="rating" value="5" class="mask mask-star-2 bg-orange-400" checked/>
												</div>
											</div>
											<div class="form-control mb-4">
												<label class="label">
													<span class="label-text">Comment</span>
												</label>
												<textarea name="comment" class="textarea textarea-bordered h-24 dark:bg-gray-700 dark:text-white" placeholder="Share your experience..."></textarea>
											</div>
											<div class="modal-action">
												<button
													type="button"
													class="btn btn-ghost"
													_={ fmt.Sprintf("on click me('#review-modal-%s').close()", p.ID) }
												>
													Cancel
												</button>
												<button type="submit" class="btn btn-primary">Submit Review</button>
											</div>
										</form>
									</div>
									<form method="dialog" class="modal-backdrop">
										<button>close</button>
									</form>
								</dialog>
							</div>
						</div>
					</div>
					<!-- Badges Section -->
					if len(p.Badges) > 0 {
						<div class="glass-card rounded-2xl p-6 mb-6 animate-fade-in-up delay-75">
							<h3 class="text-lg font-semibold text-foreground mb-4 flex items-center gap-2">
								<span class="text-xl">🏆</span> Achievements
							</h3>
							<div class="flex flex-wrap gap-4">
								for _, badge := range p.Badges {
									<div class="group relative flex flex-col items-center p-3 rounded-lg bg-secondary/30 hover:bg-secondary/50 transition-colors cursor-help" title={ badge.Name }>
										<div class="text-3xl mb-1 filter drop-shadow-md transform group-hover:scale-110 transition-transform">{ badge.Icon }</div>
										<span class="text-xs font-medium text-center max-w-[80px] leading-tight">{ badge.Name }</span>
									</div>
								}
							</div>
						</div>
					}
					<!-- Reviews Section -->
					if len(p.Reviews) > 0 {
						<div class="glass-card rounded-2xl p-6 mb-6 animate-fade-in-up delay-100">
							<h3 class="text-lg font-semibold text-foreground mb-4 flex items-center gap-2">
								<span class="text-xl">⭐</span> Recent Reviews
							</h3>
							<div class="space-y-4">
								for _, review := range p.Reviews {
									<div class="p-4 rounded-lg bg-secondary/20">
										<div class="flex items-start justify-between">
											<div class="flex items-center gap-3">
												if review.ReviewerAvatar != "" {
													<img src={ review.ReviewerAvatar } class="w-8 h-8 rounded-full object-cover"/>
												} else {
													<div class="w-8 h-8 rounded-full bg-primary flex items-center justify-center text-primary-foreground text-xs font-bold">
														{ getPublicInitial(review.ReviewerName) }
													</div>
												}
												<div>
													<p class="text-sm font-semibold">{ review.ReviewerName }</p>
													<p class="text-xs text-muted-foreground">{ review.CreatedAt.Format("Jan 02, 2006") }</p>
												</div>
											</div>
											<div class="flex text-yellow-500 text-sm">
												for i := 0; i < review.Rating; i++ {
													<span>★</span>
												}
											</div>
										</div>
										if review.Comment != "" {
											<p class="mt-2 text-sm text-foreground/90">{ review.Comment }</p>
										}
									</div>
								}
							</div>
						</div>
					}
					<!-- Portfolio Section -->
					if len(p.Portfolio) > 0 {
						<div class="glass-card rounded-2xl p-6 mb-6 animate-fade-in-up delay-150">
							<h3 class="text-lg font-semibold text-foreground mb-4 flex items-center gap-2">
								<span class="text-xl">🚀</span> Portfolio
							</h3>
							<div class="grid md:grid-cols-2 gap-4">
								for _, item := range p.Portfolio {
									<div class="p-4 bg-secondary/20 rounded-xl hover:bg-secondary/30 transition-colors">
										<div class="flex justify-between items-start">
											<div>
												<h4 class="font-bold text-foreground">{ item.Title }</h4>
												<p class="text-sm text-muted-foreground mt-1 line-clamp-2">{ item.Description }</p>
											</div>
											if item.LinkURL != "" {
												<a href={ templ.SafeURL(item.LinkURL) } target="_blank" class="btn btn-circle btn-sm btn-ghost">
													<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
												</a>
											}
										</div>
									</div>
								}
							</div>
						</div>
					}
					<!-- Skills Sections -->
					<div class="grid md:grid-cols-2 gap-6">
						<!-- Skills They Teach -->
						<div class="glass-card rounded-xl p-6 animate-fade-in-up delay-100">
							<div class="flex items-center gap-3 mb-4">
								<div class="w-10 h-10 rounded-full bg-emerald-500/10 flex items-center justify-center">
									<svg class="w-5 h-5 text-emerald-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"></path>
									</svg>
								</div>
								<h2 class="text-lg font-semibold text-foreground">Can Teach</h2>
							</div>
							if len(p.OfferedSkills) == 0 {
								<p class="text-sm text-muted-foreground">No teaching skills listed yet</p>
							} else {
								<div class="flex flex-wrap gap-2">
									for _, skill := range p.OfferedSkills {
										<span class="px-3 py-1 text-sm rounded-full bg-emerald-500/10 text-emerald-600 dark:text-emerald-400">
											{ skill }
										</span>
									}
								</div>
							}
						</div>
						<!-- Skills They Want -->
						<div class="glass-card rounded-xl p-6 animate-fade-in-up delay-200">
							<div class="flex items-center gap-3 mb-4">
								<div class="w-10 h-10 rounded-full bg-blue-500/10 flex items-center justify-center">
									<svg class="w-5 h-5 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
									</svg>
								</div>
								<h2 class="text-lg font-semibold text-foreground">Wants to Learn</h2>
							</div>
							if len(p.WantedSkills) == 0 {
								<p class="text-sm text-muted-foreground">No learning goals listed yet</p>
							} else {
								<div class="flex flex-wrap gap-2">
									for _, skill := range p.WantedSkills {
										<span class="px-3 py-1 text-sm rounded-full bg-blue-500/10 text-blue-600 dark:text-blue-400">
											{ skill }
										</span>
									}
								</div>
							}
						</div>
					</div>
					<!-- Back Link -->
					<div class="mt-8 text-center">
						<a href="/connections" class="text-sm text-muted-foreground hover:text-primary transition-colors">
							← Back to Connections
						</a>
					</div>
				</div>
			</main>
			@components.Footer()
		</div>
	}
}

func getPublicInitial(name string) string {
	if len(name) == 0 {
		return "?"
	}
	runes := []rune(name)
	return string(runes[0])
}
