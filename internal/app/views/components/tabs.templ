package components

// TabItem represents a single tab
type TabItem struct {
	ID       string
	Label    string
	Icon     string // Optional icon name
	URL      string // HTMX endpoint for tab content
	Selected bool
}

// Tabs renders HTMX-powered tabs following HATEOAS pattern
// The tabs are server-rendered and state is managed via hypermedia
templ Tabs(tabs []TabItem, targetID string) {
	<div class="tabs-container w-full" role="tablist" aria-label="Content tabs">
		<!-- Mobile-friendly horizontal scrolling tabs -->
		<div class="relative">
			<!-- Gradient fade indicators for scroll -->
			<div class="pointer-events-none absolute left-0 top-0 bottom-0 w-6 bg-gradient-to-r from-background to-transparent z-10 opacity-0 md:hidden" id="scroll-fade-left"></div>
			<div class="pointer-events-none absolute right-0 top-0 bottom-0 w-6 bg-gradient-to-l from-background to-transparent z-10 opacity-0 md:hidden" id="scroll-fade-right"></div>
			<div class="flex border-b border-border overflow-x-auto scrollbar-hide scroll-smooth -webkit-overflow-scrolling-touch pb-px">
				for _, tab := range tabs {
					<button
						hx-get={ tab.URL }
						hx-target="#settings-tabs"
						hx-swap="innerHTML"
						hx-push-url="true"
						class={ "tab-button flex items-center gap-2 px-3 md:px-4 py-3 text-xs md:text-sm font-medium whitespace-nowrap transition-all duration-200 border-b-2 -mb-px flex-shrink-0",
							templ.KV("border-primary text-primary", tab.Selected),
							templ.KV("border-transparent text-muted-foreground hover:text-foreground hover:border-border", !tab.Selected) }
						role="tab"
						aria-selected={ boolToString(tab.Selected) }
						aria-controls={ targetID }
					>
						if tab.Icon != "" {
							<span class="hidden sm:inline">
								@TabIcon(tab.Icon)
							</span>
						}
						{ tab.Label }
					</button>
				}
			</div>
		</div>
	</div>
}

// TabsVertical renders vertical tabs for sidebar navigation
templ TabsVertical(tabs []TabItem, targetID string) {
	<div class="tabs-vertical" role="tablist" aria-orientation="vertical" aria-label="Settings navigation">
		<nav class="flex flex-col gap-1">
			for _, tab := range tabs {
				<button
					hx-get={ tab.URL }
					hx-target={ "#" + targetID }
					hx-swap="innerHTML"
					hx-push-url="true"
					class={ "flex items-center gap-3 px-4 py-3 rounded-lg text-sm font-medium transition-all duration-200",
						templ.KV("bg-primary/10 text-primary", tab.Selected),
						templ.KV("text-muted-foreground hover:bg-secondary hover:text-foreground", !tab.Selected) }
					role="tab"
					aria-selected={ boolToString(tab.Selected) }
					aria-controls={ targetID }
				>
					if tab.Icon != "" {
						@TabIcon(tab.Icon)
					}
					{ tab.Label }
				</button>
			}
		</nav>
	</div>
}

// TabPanel wraps tab content with proper ARIA attributes
templ TabPanel(id string) {
	<div id={ id } role="tabpanel" class="tab-panel animate-fade-in">
		{ children... }
	</div>
}

// TabIcon renders an icon based on name
templ TabIcon(name string) {
	switch name {
		case "account":
			<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
			</svg>
		case "notifications":
			<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"></path>
			</svg>
		case "privacy":
			<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
			</svg>
		case "security":
			<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
			</svg>
		case "appearance":
			<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01"></path>
			</svg>
		case "danger":
			<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
			</svg>
		case "profile":
			<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5.121 17.804A13.937 13.937 0 0112 16c2.5 0 4.847.655 6.879 1.804M15 10a3 3 0 11-6 0 3 3 0 016 0zm6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
			</svg>
		case "skills":
			<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"></path>
			</svg>
		case "portfolio":
			<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path>
			</svg>
		case "reviews":
			<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"></path>
			</svg>
		default:
			<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
			</svg>
	}
}

// Helper function to convert bool to string for ARIA
func boolToString(b bool) string {
	if b {
		return "true"
	}
	return "false"
}
