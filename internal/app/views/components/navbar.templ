package components

templ Navbar(isAuthenticated bool, userName string, userAvatar string) {
	<nav class="nav-premium sticky top-0 z-50" hx-boost="true" hx-target="body" hx-swap="innerHTML show:window:top">
		<div class="container mx-auto flex items-center justify-between px-4 py-3">
			<div class="flex items-center gap-3">
				<!-- Mobile Menu Toggle (visible only on mobile) -->
				if isAuthenticated {
					<button
						id="mobile-menu-toggle"
						class="md:hidden p-2 rounded-lg hover:bg-muted transition-colors"
						aria-label="Toggle menu"
						data-mobile-menu-toggle
					>
						<svg class="w-6 h-6 hamburger-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
						</svg>
						<svg class="w-6 h-6 close-icon hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
						</svg>
						<script>
							me().on("click", ev => {
								halt(ev)
								me('#mobile-menu').classToggle('hidden')
								me('#mobile-menu-backdrop').classToggle('hidden')
								me('.hamburger-icon', me(ev)).classToggle('hidden')
								me('.close-icon', me(ev)).classToggle('hidden')
							})
						</script>
					</button>
				}
				<a href="/" class="logo-monogram text-foreground hover:text-primary transition-all duration-300 inline-flex items-center gap-1">
					<span class="text-gradient font-black text-2xl tracking-tight">Talent</span>
					<span class="separator"></span>
					<span class="font-semibold text-xl">Synapse</span>
				</a>
			</div>
			<div class="flex-none">
				<div class="flex items-center gap-1 md:gap-2">
					<a href="/" class="nav-link hidden md:inline-flex">Home</a>
					if isAuthenticated {
						<a href="/dashboard" class="nav-link hidden md:inline-flex">Dashboard</a>
						<a href="/skills" class="nav-link hidden md:inline-flex">Skills</a>
						<a href="/calendar" class="nav-link hidden md:inline-flex">Calendar</a>
						<a href="/sessions" class="nav-link hidden md:inline-flex">Sessions</a>
						<!-- User Dropdown (Hyperscript) -->
						<div class="relative ml-2" id="user-dropdown">
							<button
								class="flex items-center gap-2 px-3 py-1.5 rounded-full bg-muted hover:bg-muted/80 transition-all duration-300"
							>
								if userAvatar != "" {
									<img src={ userAvatar } alt="Avatar" class="w-7 h-7 rounded-full object-cover ring-2 ring-primary/20"/>
								} else {
									<div class="w-7 h-7 rounded-full bg-primary/20 flex items-center justify-center text-primary font-semibold text-sm">
										{ string([]rune(userName)[0]) }
									</div>
								}
								<span class="hidden md:inline text-sm font-medium text-foreground">{ userName }</span>
								<svg id="dropdown-chevron" class="w-4 h-4 text-muted-foreground transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
								</svg>
								<script>
									me().on("click", ev => {
										halt(ev)
										me('#dropdown-menu').classToggle('hidden')
										me('#dropdown-chevron').classToggle('rotate-180')
									})
								</script>
							</button>
							<div
								id="dropdown-menu"
								class="hidden absolute right-0 mt-2 w-48 rounded-xl bg-card border border-border shadow-xl py-1 z-50"
							>
								<a href="/profile" class="flex items-center gap-2 px-4 py-2 text-sm text-foreground hover:bg-muted transition-colors">
									Profile
								</a>
								<a href="/settings" class="flex items-center gap-2 px-4 py-2 text-sm text-foreground hover:bg-muted transition-colors">
									Settings
								</a>
								<div class="border-t border-border my-1"></div>
								<form action="/logout" method="POST">
									<button type="submit" class="w-full flex items-center gap-2 px-4 py-2 text-sm text-destructive hover:bg-destructive/10 transition-colors">
										Sign Out
									</button>
								</form>
							</div>
							<script>
								// Click-away handler to close dropdown
								document.addEventListener('click', (e) => {
									const dropdown = me('#user-dropdown')
									if (dropdown && !dropdown.contains(e.target)) {
										me('#dropdown-menu')?.classAdd('hidden')
										me('#dropdown-chevron')?.classRemove('rotate-180')
									}
								})
							</script>
						</div>
					} else {
						<a href="/login" class="btn btn-sm btn-ghost font-medium">Sign In</a>
						<a href="/register" class="btn btn-sm btn-primary btn-glow font-medium">Get Started</a>
					}
					<!-- Theme Toggle (Hyperscript) -->
					<div class="ml-1">
						<button
							class="btn btn-sm btn-icon btn-ghost"
							aria-label="Toggle theme"
						>
							<!-- Sun icon (shown in dark mode) -->
							<svg class="h-5 w-5 sun-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
								<path d="M5.64,17l-.71.71a1,1,0,0,0,0,1.41,1,1,0,0,0,1.41,0l.71-.71A1,1,0,0,0,5.64,17ZM5,12a1,1,0,0,0-1-1H3a1,1,0,0,0,0,2H4A1,1,0,0,0,5,12Zm7-7a1,1,0,0,0,1-1V3a1,1,0,0,0-2,0V4A1,1,0,0,0,12,5ZM5.64,7.05a1,1,0,0,0,.7.29,1,1,0,0,0,.71-.29,1,1,0,0,0,0-1.41l-.71-.71A1,1,0,0,0,4.93,6.34Zm12,.29a1,1,0,0,0,.7-.29l.71-.71a1,1,0,1,0-1.41-1.41L17,5.64a1,1,0,0,0,0,1.41A1,1,0,0,0,17.66,7.34ZM21,11H20a1,1,0,0,0,0,2h1a1,1,0,0,0,0-2Zm-9,8a1,1,0,0,0-1,1v1a1,1,0,0,0,2,0V20A1,1,0,0,0,12,19ZM18.36,17A1,1,0,0,0,17,18.36l.71.71a1,1,0,0,0,1.41,0,1,1,0,0,0,0-1.41ZM12,6.5A5.5,5.5,0,1,0,17.5,12,5.51,5.51,0,0,0,12,6.5Zm0,9A3.5,3.5,0,1,1,15.5,12,3.5,3.5,0,0,1,12,15.5Z"></path>
							</svg>
							<!-- Moon icon (shown in light mode) -->
							<svg class="h-5 w-5 moon-icon hidden" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
								<path d="M21.64,13a1,1,0,0,0-1.05-.14,8.05,8.05,0,0,1-3.37.73A8.15,8.15,0,0,1,9.08,5.49a8.59,8.59,0,0,1,.25-2A1,1,0,0,0,8,2.36,10.14,10.14,0,1,0,22,14.05,1,1,0,0,0,21.64,13Zm-9.5,6.69A8.14,8.14,0,0,1,7.08,5.22v.27A10.15,10.15,0,0,0,17.22,15.63a9.79,9.79,0,0,0,2.1-.22A8.11,8.11,0,0,1,12.14,19.73Z"></path>
							</svg>
							<script>
								me().on("click", ev => {
									document.documentElement.classList.toggle('dark')
									const isDark = document.documentElement.classList.contains('dark')
									localStorage.setItem('theme', isDark ? 'dark' : 'light')

									me('.sun-icon', me(ev)).classToggle('hidden')
									me('.moon-icon', me(ev)).classToggle('hidden')
								})
							</script>
						</button>
					</div>
				</div>
			</div>
		</div>
		<!-- Mobile Menu Backdrop -->
		if isAuthenticated {
			<div
				id="mobile-menu-backdrop"
				class="hidden fixed inset-0 bg-black/50 z-40 md:hidden"
			>
				<script>
					me().on("click", ev => {
						me('#mobile-menu').classAdd('hidden')
						me('#mobile-menu-backdrop').classAdd('hidden')
						me('.hamburger-icon').classRemove('hidden')
						me('.close-icon').classAdd('hidden')
					})
				</script>
			</div>
			<!-- Mobile Menu Drawer -->
			<div
				id="mobile-menu"
				class="hidden fixed top-[60px] left-0 right-0 bg-card border-b border-border shadow-lg z-50 md:hidden"
				data-mobile-menu
			>
				<div class="container mx-auto px-4 py-4 space-y-2">
					<a href="/" class="flex items-center gap-3 px-4 py-3 rounded-lg text-foreground hover:bg-muted transition-colors">
						<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path>
						</svg>
						<span class="font-medium">Home</span>
					</a>
					<a href="/dashboard" class="flex items-center gap-3 px-4 py-3 rounded-lg text-foreground hover:bg-muted transition-colors">
						<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 5a1 1 0 011-1h14a1 1 0 011 1v2a1 1 0 01-1 1H5a1 1 0 01-1-1V5zM4 13a1 1 0 011-1h6a1 1 0 011 1v6a1 1 0 01-1 1H5a1 1 0 01-1-1v-6zM16 13a1 1 0 011-1h2a1 1 0 011 1v6a1 1 0 01-1 1h-2a1 1 0 01-1-1v-6z"></path>
						</svg>
						<span class="font-medium">Dashboard</span>
					</a>
					<a href="/skills" class="flex items-center gap-3 px-4 py-3 rounded-lg text-foreground hover:bg-muted transition-colors">
						<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"></path>
						</svg>
						<span class="font-medium">Skills</span>
					</a>
					<a href="/calendar" class="flex items-center gap-3 px-4 py-3 rounded-lg text-foreground hover:bg-muted transition-colors">
						<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
						</svg>
						<span class="font-medium">Calendar</span>
					</a>
					<a href="/sessions" class="flex items-center gap-3 px-4 py-3 rounded-lg text-foreground hover:bg-muted transition-colors">
						<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
						</svg>
						<span class="font-medium">Sessions</span>
					</a>
					<div class="border-t border-border my-2 pt-2">
						<a href="/profile" class="flex items-center gap-3 px-4 py-3 rounded-lg text-foreground hover:bg-muted transition-colors">
							<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
							</svg>
							<span class="font-medium">Profile</span>
						</a>
						<a href="/settings" class="flex items-center gap-3 px-4 py-3 rounded-lg text-foreground hover:bg-muted transition-colors">
							<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path>
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
							</svg>
							<span class="font-medium">Settings</span>
						</a>
					</div>
				</div>
			</div>
		}
	</nav>
}
