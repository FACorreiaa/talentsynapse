package components

templ Footer() {
	<footer class="bg-muted text-muted-foreground border-t border-border">
		<div class="container mx-auto px-4 py-10 text-center">
			<div class="mb-4">
				<p class="font-bold text-lg">
					<span class="text-primary">Skill</span><span class="text-foreground">sphere</span>
				</p>
			</div>
			<!-- Logo Monogram -->
			<div class="flex-1">
				<a href="/" class="logo-monogram text-foreground hover:text-primary transition-colors">
					<span class="text-primary font-bold">F</span>
					<span class="separator"></span>
					<span>C</span>
				</a>
			</div>
			<p class="text-sm">Copyright © 2024 - All rights reserved</p>
		</div>
	</footer>
}
